#!/usr/bin/env bash
#
# RSPKU pre-commit hook
# -----------------------------------------------------------------------------
# Runs fast static checks on staged files before they make it into a commit.
#
# Install (one-time, per clone):
#   git config core.hooksPath .github/hooks
#
# Bypass (use sparingly):
#   git commit --no-verify
#
# The hook exits non-zero on any failure so the commit is aborted and the
# author has a chance to fix issues.

set -euo pipefail

# ANSI helpers -----------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

say() { printf "${GREEN}[pre-commit]${NC} %s\n" "$*"; }
warn() { printf "${YELLOW}[pre-commit]${NC} %s\n" "$*"; }
fail() { printf "${RED}[pre-commit]${NC} %s\n" "$*" >&2; exit 1; }

# Collect staged files ---------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [[ -z "${STAGED_FILES}" ]]; then
  say "No staged files, skipping checks."
  exit 0
fi

# 1. PHP lint on staged .php files --------------------------------------------
PHP_FILES=$(echo "${STAGED_FILES}" | grep -E '\.php$' || true)

if [[ -n "${PHP_FILES}" ]]; then
  say "Linting $(echo "${PHP_FILES}" | wc -l | tr -d ' ') staged PHP files..."

  LINT_FAILED=0
  while IFS= read -r file; do
    [[ -z "${file}" ]] && continue
    [[ ! -f "${file}" ]] && continue

    if ! php -l "${file}" >/dev/null 2>&1; then
      warn "Syntax error in: ${file}"
      php -l "${file}" || true
      LINT_FAILED=1
    fi
  done <<< "${PHP_FILES}"

  if [[ "${LINT_FAILED}" -eq 1 ]]; then
    fail "PHP syntax errors detected. Fix them before committing."
  fi
  say "PHP lint passed."
fi

# 2. PHPStan when PHP files touched & composer is installed -------------------
if [[ -n "${PHP_FILES}" ]] && [[ -f vendor/bin/phpstan ]]; then
  say "Running PHPStan (level 5)..."
  if ! vendor/bin/phpstan analyse --memory-limit=2G --no-progress -q; then
    fail "PHPStan reported errors. Fix them before committing."
  fi
  say "PHPStan passed."
elif [[ -n "${PHP_FILES}" ]]; then
  warn "vendor/bin/phpstan not found. Run 'composer install' to enable PHPStan in pre-commit."
fi

# 3. Twig smoke check (balanced braces) ---------------------------------------
TWIG_FILES=$(echo "${STAGED_FILES}" | grep -E '\.twig$' || true)

if [[ -n "${TWIG_FILES}" ]]; then
  say "Checking balanced Twig tags..."
  TWIG_FAILED=0
  while IFS= read -r file; do
    [[ -z "${file}" ]] && continue
    [[ ! -f "${file}" ]] && continue

    # Count opening/closing tags. Not a full parse but catches the common
    # "I forgot {% endif %}" mistake cheaply.
    OPEN=$(grep -cE '\{%\s*(if|for|block|macro|embed|with)\b' "${file}" || true)
    CLOSE=$(grep -cE '\{%\s*(endif|endfor|endblock|endmacro|endembed|endwith)\b' "${file}" || true)

    if [[ "${OPEN}" -ne "${CLOSE}" ]]; then
      warn "Twig tag imbalance in: ${file} (open=${OPEN}, close=${CLOSE})"
      TWIG_FAILED=1
    fi
  done <<< "${TWIG_FILES}"

  if [[ "${TWIG_FAILED}" -eq 1 ]]; then
    fail "Unbalanced Twig tags detected."
  fi
  say "Twig smoke check passed."
fi

# 4. Reject committing dangerous root-level PHP files -------------------------
BANNED_FILES=("file-manager.php" "clear-cache.php" "adminer.php" "phpmyadmin.php" "shell.php")
for banned in "${BANNED_FILES[@]}"; do
  if echo "${STAGED_FILES}" | grep -qx "${banned}"; then
    fail "Refusing to commit ${banned} (see SECURITY-AUDIT-2026-05-11.md)."
  fi
done

# 5. Reject committing .env or wp-config with credentials ---------------------
if echo "${STAGED_FILES}" | grep -qxE "wp-config\.php|\.env(\..+)?"; then
  fail "Refusing to commit wp-config.php or .env files. Use wp-config-sample.php and .env.example for templates."
fi

say "All pre-commit checks passed."
exit 0

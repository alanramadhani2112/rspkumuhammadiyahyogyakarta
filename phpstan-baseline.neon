parameters:
	ignoreErrors:
		-
			message: "#^Static method RSPKU_CPT_DoctorFields\\:\\:scheduleRow\\(\\) is unused\\.$#"
			count: 1
			path: wp-content/plugins/rspku-cpt/includes/class-rspku-cpt-doctor-fields.php

		-
			message: "#^Constant RSPKU_SETTINGS_URL not found\\.$#"
			count: 2
			path: wp-content/plugins/rspku-settings/includes/class-rspku-settings-admin.php

		-
			message: "#^Parameter \\#2 \\$args of function register_block_type expects array\\{api_version\\?\\: string, title\\?\\: string, category\\?\\: string\\|null, parent\\?\\: array\\<string\\>\\|null, ancestor\\?\\: array\\<string\\>\\|null, allowed_blocks\\?\\: array\\<string\\>\\|null, icon\\?\\: string\\|null, description\\?\\: string, \\.\\.\\.\\}, array\\{api_version\\: 2, title\\: string, category\\: 'rspku', icon\\: 'heart', attributes\\: array\\<string, array\\<string, 6\\|8\\|array\\{\\}\\|string\\>\\>, render_callback\\: array\\{'Rspku\\\\\\\\Blocks\\\\\\\\Registry', 'articleList'\\|'ctaBanner'\\|'doctorGrid'\\|'doctorSearch'\\|'faq'\\|'heroBanner'\\|'insurancePartners'\\|'journalList'\\|'serviceCards'\\}\\} given\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Blocks/Registry.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Controllers/TemplateController.php

		-
			message: "#^Offset 1 on array\\{string, string\\} on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Helpers/Icon.php

		-
			message: "#^Method Rspku\\\\Repositories\\\\DoctorScheduleRepository\\:\\:headers\\(\\) is unused\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Method Rspku\\\\Repositories\\\\DoctorScheduleRepository\\:\\:parseRow\\(\\) is unused\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Method Rspku\\\\Repositories\\\\DoctorScheduleRepository\\:\\:recordFromDoctor\\(\\) never returns null so it can be removed from the return type\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Method Rspku\\\\Repositories\\\\DoctorScheduleRepository\\:\\:specializationCopy\\(\\) should return array\\<string, array\\<string, mixed\\>\\> but returns array\\<string, string\\>\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Offset 'slug' on array\\{id\\: int, name\\: string, slug\\: string, category\\: string\\} on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Offset 1 on array\\{string, non\\-falsy\\-string, non\\-falsy\\-string\\} on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Offset 2 on array\\{string, non\\-falsy\\-string, non\\-falsy\\-string\\} on left side of \\?\\? always exists and is not nullable\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Repositories/DoctorScheduleRepository.php

		-
			message: "#^Constant RSPKU_THEME_URL not found\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Setup/Assets.php

		-
			message: "#^Call to method addFunction\\(\\) on an unknown class Twig\\\\Environment\\.$#"
			count: 2
			path: wp-content/themes/rspku-theme/app/Setup/TimberSetup.php

		-
			message: "#^Constant RSPKU_THEME_URL not found\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Setup/TimberSetup.php

		-
			message: "#^Instantiated class Twig\\\\TwigFunction not found\\.$#"
			count: 2
			path: wp-content/themes/rspku-theme/app/Setup/TimberSetup.php

		-
			message: "#^Method Rspku\\\\Setup\\\\TimberSetup\\:\\:extendTwig\\(\\) has invalid return type Twig\\\\Environment\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Setup/TimberSetup.php

		-
			message: "#^Parameter \\$twig of method Rspku\\\\Setup\\\\TimberSetup\\:\\:extendTwig\\(\\) has invalid type Twig\\\\Environment\\.$#"
			count: 1
			path: wp-content/themes/rspku-theme/app/Setup/TimberSetup.php

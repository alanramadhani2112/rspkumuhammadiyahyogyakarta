{
    "name": "rspku/dev-tooling",
    "description": "Development tooling (static analysis, tests, linting) for the RSPKU project monorepo. Runtime dependencies for the theme live in wp-content/themes/rspku-theme/composer.json.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=2G",
        "phpstan:baseline": "phpstan analyse --memory-limit=2G --generate-baseline"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{% set current_page = current_page|default(1) %}
{% set total_pages = total_pages|default(pagination ? 2 : 1) %}
{% set total = total|default(0) %}
{% set per_page = per_page|default(0) %}
{% set show_single = show_single|default(false) %}
{% set show_summary = show_summary is defined ? show_summary : true %}
{% set item_label = item_label|default('item') %}
{% set start_item = total > 0 and per_page > 0 ? ((current_page - 1) * per_page) + 1 : 0 %}
{% set page_end_candidate = current_page * per_page %}
{% set end_item = total > 0 and per_page > 0 ? (page_end_candidate > total ? total : page_end_candidate) : 0 %}

{% if pagination or show_single %}
  <nav class="rspku-pagination-shell {{ class|default('') }}" aria-label="{{ label|default('Pagination') }}">
    {% if show_summary and total > 0 and per_page > 0 %}
      <p class="rspku-pagination-summary">Menampilkan {{ start_item }}-{{ end_item }} dari {{ total }} {{ item_label }}</p>
    {% endif %}
    {% if pagination %}
      <div class="rspku-pagination-links pagination">{{ pagination|raw }}</div>
    {% else %}
      <div class="rspku-pagination-links rspku-table-pagination">
        <span class="rspku-pagination-button is-active">1</span>
      </div>
    {% endif %}
  </nav>
{% endif %}

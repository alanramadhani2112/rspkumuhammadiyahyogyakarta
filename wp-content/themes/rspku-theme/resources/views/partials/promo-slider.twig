{% set slides = slides|default([]) %}
{% set slide_count = slides|length %}

{% if slide_count > 0 %}
  {% if slide_count == 1 %}
    {% set slide = slides|first %}
    {% set cta_href = slide.cta_url starts with 'https://' ? slide.cta_url : (slide.cta_url starts with '/' ? site.url ~ slide.cta_url : '') %}
    {% if cta_href %}
      <a href="{{ cta_href }}" class="block overflow-hidden" aria-label="{{ slide.image_alt|default('Promo RS PKU') }}">
    {% else %}
      <div class="overflow-hidden">
    {% endif %}
        {% include 'partials/responsive-image.twig' with {
          id: slide.image_id,
          url: slide.image_url,
          alt: slide.image_alt|default('Promo RS PKU'),
          class: 'aspect-[4/3] w-full object-cover',
          sizes: '(min-width: 1024px) 50vw, 100vw',
          width: 1200,
          height: 900,
          eager: true
        } only %}
    {% if cta_href %}
      </a>
    {% else %}
      </div>
    {% endif %}
  {% else %}
    <div
      x-data="promoSlider()"
      x-init="setup({{ slide_count }})"
      x-on:mouseenter="pause()"
      x-on:mouseleave="resume()"
      x-on:focusin="pause()"
      x-on:focusout="resume()"
      x-on:keydown="onKeydown($event)"
      class="relative overflow-hidden"
      role="region"
      aria-roledescription="carousel"
      aria-label="Promo RS PKU"
      aria-live="off"
      tabindex="0"
    >
      <div
        class="flex"
        x-bind:class="reducedMotion ? 'transition-none' : 'transition-transform duration-500 ease-out'"
        x-bind:style="`transform: translateX(-${index * 100}%);`"
      >
        {% for slide in slides %}
          {% set cta_href = slide.cta_url starts with 'https://' ? slide.cta_url : (slide.cta_url starts with '/' ? site.url ~ slide.cta_url : '') %}
          <article
            class="w-full shrink-0"
            x-bind:aria-hidden="index !== {{ loop.index0 }}"
            x-bind:inert="index !== {{ loop.index0 }}"
            aria-roledescription="slide"
            aria-label="Promo {{ loop.index }} dari {{ slide_count }}"
          >
            {% if cta_href %}
              <a href="{{ cta_href }}" class="block" aria-label="{{ slide.image_alt|default('Promo RS PKU') }}">
            {% endif %}
                {% include 'partials/responsive-image.twig' with {
                  id: slide.image_id,
                  url: slide.image_url,
                  alt: slide.image_alt|default('Promo RS PKU'),
                  class: 'aspect-[4/3] w-full object-cover',
                  sizes: '(min-width: 1024px) 50vw, 100vw',
                  width: 1200,
                  height: 900,
                  eager: loop.first
                } only %}
            {% if cta_href %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      <button type="button" class="absolute left-4 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-slate-950 shadow-lg transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Promo sebelumnya" x-on:click="prev()">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button type="button" class="absolute right-4 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-slate-950 shadow-lg transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Promo berikutnya" x-on:click="next()">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

      <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-0.5" role="tablist" aria-label="Pilih promo">
        {% for slide in slides %}
          <button type="button" class="grid h-11 w-7 place-items-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Tampilkan promo {{ loop.index }}" x-on:click="goTo({{ loop.index0 }})">
            <span class="block h-2.5 w-2.5 rounded-full shadow-sm transition" x-bind:class="index === {{ loop.index0 }} ? 'bg-white' : 'bg-white/60'"></span>
          </button>
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endif %}

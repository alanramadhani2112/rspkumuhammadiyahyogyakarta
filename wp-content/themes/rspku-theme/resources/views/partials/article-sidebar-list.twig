{% if items %}
  <section class="rspku-side-panel">
    <div class="flex items-center gap-3">
      <div class="grid h-11 w-11 place-items-center rounded-[0.95rem] border border-slate-200 bg-[#f7faf7] text-hospital-700">
        {{ icon(icon_name|default('newspaper'), { class: 'h-5 w-5' }) }}
      </div>
      <div>
        <p class="text-sm font-medium text-slate-500">{{ eyebrow|default('Sidebar') }}</p>
        <h2 class="text-[1.05rem] font-semibold text-slate-950">{{ title }}</h2>
      </div>
    </div>

    <div class="mt-5 divide-y divide-slate-100">
      {% for item in items %}
        <article class="py-4 {{ loop.first ? 'pt-0' : '' }}">
          <a href="{{ item.url }}" class="flex gap-3 transition hover:text-hospital-700">
            {% if item.image and item.image.url %}
              <span class="block h-14 w-[4.5rem] shrink-0 overflow-hidden rounded-[0.75rem] border border-slate-200 bg-slate-100">
                <img src="{{ item.image.url }}" alt="{{ item.title }}" class="h-full w-full object-cover">
              </span>
            {% endif %}
            <span class="min-w-0 flex-1">
              <span class="block text-[13.5px] font-semibold leading-6 text-slate-950">{{ item.title }}</span>
              <span class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[12px] leading-5 text-slate-500">
                {% if item.date %}
                  <span>{{ item.date }}</span>
                {% endif %}
                {% if item.views %}
                  <span>{{ item.views }} dibaca</span>
                {% endif %}
              </span>
            </span>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

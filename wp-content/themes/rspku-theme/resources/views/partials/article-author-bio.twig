{#
  Article Author Bio Card
  Fulfils spec R2. Displays author avatar (or initial fallback), name,
  optional credentials (from `_rspku_author_credentials` user meta),
  and bio (`description`).

  Usage:
  {% include 'partials/article-author-bio.twig' with { post: post } only %}

  Props:
  - post (required): Timber post object (EnhancedPost subclass so
    `author_credentials()` is available).
#}

{% if post.author %}
  {% set author = post.author %}
  {% set avatar = author.avatar %}
  {% set credentials = post.author_credentials|default('') %}
  {% set bio = author.description|default('') %}
  {% set initial = author.name|default(author.display_name|default('?'))|slice(0, 1)|upper %}

  <section class="mt-12 rounded-md border border-slate-200 bg-white p-6" aria-label="Tentang penulis">
    <div class="flex items-start gap-5">
      {% if avatar and avatar.src %}
        <img src="{{ avatar.src }}"
             alt="{{ author.name }}"
             loading="lazy"
             width="96"
             height="96"
             class="h-20 w-20 shrink-0 rounded-full bg-slate-100 object-cover">
      {% else %}
        <div class="grid h-20 w-20 shrink-0 place-items-center rounded-full bg-hospital-100 text-2xl font-bold text-hospital-700">
          {{ initial }}
        </div>
      {% endif %}

      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Penulis</p>
        <p class="mt-1 text-lg font-semibold text-slate-950">{{ author.name }}</p>
        {% if credentials %}
          <p class="mt-0.5 text-sm font-medium text-hospital-700">{{ credentials }}</p>
        {% endif %}
        {% if bio %}
          <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3">{{ bio }}</p>
        {% endif %}
        {% if author.link %}
          <a href="{{ author.link }}"
             class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-hospital-700 hover:text-hospital-800">
            <span>Lihat semua tulisan</span>
            {{ icon('arrow-right', { class: 'h-3 w-3' }) }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% set items = items|default([]) %}

{% if items %}
  <section class="rspku-profile-block">
    <div class="rspku-profile-block-heading">
      <span class="rspku-profile-block-icon">
        {{ icon(icon_name|default('graduation-cap'), { class: 'h-5 w-5' }) }}
      </span>
      <div>
        <p class="rspku-profile-block-kicker">{{ kicker|default('Profil dokter') }}</p>
        <h2 class="rspku-profile-block-title">{{ title }}</h2>
      </div>
    </div>

    <div class="rspku-credential-list" role="list">
      {% for item in items %}
        <article class="rspku-credential-item{% if not item.period %} rspku-credential-item--plain{% endif %}" role="listitem">
          {% if item.period %}
            <p class="rspku-credential-period">{{ item.period }}</p>
          {% endif %}
          <p class="rspku-credential-description">{{ item.description }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

<article class="rspku-card overflow-hidden rounded-lg p-4 sm:p-5">
  {% set specialization = doctor.primary_specialization ?: doctor.specializations|first %}

  {# Header: Avatar + Name + Specialization #}
  <div class="flex items-start gap-4">
    <div class="h-14 w-14 shrink-0 overflow-hidden rounded-lg bg-slate-100">
      {% if doctor.photo.url %}
        <img src="{{ doctor.photo.url }}" alt="{{ doctor.name }}" loading="lazy" class="h-full w-full object-cover">
      {% else %}
        <div class="grid h-full w-full place-items-center bg-hospital-50 text-xl font-bold text-hospital-700">{{ doctor.name|slice(0, 1)|upper }}</div>
      {% endif %}
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="text-sm font-semibold leading-snug text-slate-950">
        <a href="{{ doctor.url }}" class="transition hover:text-hospital-700">{{ doctor.name }}</a>
      </h3>
      <p class="mt-1 text-xs text-slate-500">{{ specialization.name|default('Dokter Umum') }}</p>
    </div>
  </div>

  {# Schedule — 2 column grid, compact badges #}
  {% if doctor.schedule %}
    <div class="mt-3 grid grid-cols-2 gap-1.5">
      {% for row in doctor.schedule|slice(0, 4) %}
        <span class="inline-flex items-center gap-1 rounded bg-slate-50 px-2 py-1.5 text-xs text-slate-700">
          {{ icon('calendar', { class: 'h-3 w-3 shrink-0 text-slate-400' }) }}
          <span>{{ row.day_label|default(row.day) }} {{ row.start_time }}{% if row.end_time %}-{{ row.end_time }}{% endif %}</span>
        </span>
      {% endfor %}
    </div>
    {% if doctor.schedule|length > 4 %}
      <p class="mt-1.5 text-xs text-hospital-700">+{{ doctor.schedule|length - 4 }} jadwal lainnya</p>
    {% endif %}
  {% endif %}

  {# Actions — with icons #}
  <div class="mt-4 grid grid-cols-2 gap-2">
    <a href="{{ doctor.url }}" class="rspku-button rspku-button-secondary rspku-button-sm justify-center">
      {{ icon('user-round', { class: 'h-3.5 w-3.5' }) }}
      <span>Profil</span>
    </a>
    {% set doctor_appointment_fallback_url = appointment_fallback_url|default('/kontak/') %}
    {% set doctor_appointment_fallback_href = doctor_appointment_fallback_url starts with 'http' or doctor_appointment_fallback_url starts with 'tel:' or doctor_appointment_fallback_url starts with 'mailto:' ? doctor_appointment_fallback_url : site.url ~ doctor_appointment_fallback_url %}
    <a href="{{ doctor.appointment_url ?: doctor_appointment_fallback_href }}" class="rspku-button rspku-button-primary rspku-button-sm justify-center">
      {{ icon('calendar-check', { class: 'h-3.5 w-3.5' }) }}
      <span>{{ appointment_cta_text|default('Buat janji') }}</span>
    </a>
  </div>
</article>

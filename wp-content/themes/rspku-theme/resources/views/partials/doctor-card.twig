<article class="rspku-card overflow-hidden rounded-lg p-4 sm:p-5">
  {% set specialization = doctor.primary_specialization ?: doctor.specializations|first %}
  <div class="flex items-start gap-4">
    <div class="h-16 w-16 shrink-0 overflow-hidden rounded-[0.95rem] bg-slate-100">
      {% if doctor.photo.url %}
        <img src="{{ doctor.photo.url }}" alt="{{ doctor.name }}" class="h-full w-full object-cover">
      {% else %}
        <div class="grid h-full w-full place-items-center bg-gradient-to-br from-hospital-100 to-hospital-50 text-2xl font-semibold text-hospital-700">{{ doctor.name|slice(0, 1) }}</div>
      {% endif %}
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="text-[1rem] font-semibold leading-6 text-slate-950">
        <a href="{{ doctor.url }}" class="transition hover:text-hospital-700">{{ doctor.name }}</a>
      </h3>
      <div class="mt-2 flex items-center gap-2 text-[13px] font-medium leading-6 text-slate-500">
        {{ icon('stethoscope', { class: 'h-4 w-4 shrink-0' }) }}
        <span>{{ specialization.name|default('Dokter Umum') }}</span>
      </div>
      {% if doctor.specialization_category %}
        <div class="mt-3">
          <span class="rspku-chip min-h-[2rem] px-3 text-[12px] font-semibold text-hospital-700">{{ doctor.specialization_category }}</span>
        </div>
      {% elseif doctor.sub_specialization %}
        <p class="mt-2 text-[14px] leading-6 text-slate-500">{{ doctor.sub_specialization }}</p>
      {% endif %}
    </div>
  </div>

  {% if doctor.schedule %}
    <div class="mt-4 flex flex-wrap gap-2">
      {% for row in doctor.schedule|slice(0, 4) %}
        <span class="rspku-chip rspku-schedule-chip min-h-[1.875rem] px-3 text-[12px]">{{ row.day_label|default(row.day) }}{% if row.label|default('') %} ({{ row.label }}){% elseif row.start_time %} ({{ row.start_time }}{% if row.end_time %} - {{ row.end_time }}{% endif %}){% endif %}</span>
      {% endfor %}
    </div>
  {% else %}
    <p class="mt-4 text-[13px] leading-6 text-slate-500">{{ doctor.excerpt }}</p>
  {% endif %}

  <div class="mt-5 grid grid-cols-2 gap-3">
    <a href="{{ doctor.url }}" class="rspku-button rspku-button-secondary rspku-button-sm">Profil</a>
    <a href="{{ doctor.appointment_url ?: doctor.url }}" class="rspku-button rspku-button-primary rspku-button-sm">Buat janji</a>
  </div>

  {% if doctor.excerpt and doctor.schedule %}
    <p class="mt-4 text-[13px] leading-6 text-slate-500">{{ doctor.excerpt }}</p>
  {% endif %}

  {% if doctor.services %}
    <div class="mt-4 flex flex-wrap gap-2">
      {% for service in doctor.services|slice(0, 2) %}
        <a href="{{ service.url }}" class="rspku-chip min-h-[2rem] px-3 text-[12px]">{{ service.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
</article>

{#
  Content Not Found — Fallback partial for single CPT pages
  when the context variable is null (draft, trashed, or invalid ID).

  Usage:
  {% include 'partials/content-not-found.twig' with {
    title: 'Dokter tidak ditemukan',
    back_url: site.url ~ '/dokter/',
    back_label: 'Kembali ke direktori dokter'
  } only %}

  Props:
  - title (optional): Heading text. Default: 'Konten tidak ditemukan'
  - description (optional): Body text.
  - back_url (optional): URL for back button.
  - back_label (optional): Label for back button.
#}

<section class="rspku-section pb-10">
  <div class="rspku-container">
    <div class="mx-auto max-w-xl space-y-6 py-16 text-center">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-slate-100 text-slate-400">
        {{ icon('help-circle', { class: 'h-8 w-8' }) }}
      </div>
      <h1 class="text-2xl font-bold text-slate-950">{{ title|default('Konten tidak ditemukan') }}</h1>
      <p class="text-base text-slate-600">{{ description|default('Halaman yang Anda cari tidak tersedia atau sudah dipindahkan. Silakan kembali ke halaman sebelumnya.') }}</p>
      {% if back_url is defined and back_url %}
        <a href="{{ back_url }}" class="rspku-button rspku-button-primary">
          {{ icon('arrow-right', { class: 'h-4 w-4 rotate-180' }) }}
          <span>{{ back_label|default('Kembali') }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<article class="rspku-review-card snap-start">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="rspku-star-row">
        {% for _ in 1..5 %}
          <svg aria-hidden="true" class="rspku-star" style="stroke: none" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"/>
          </svg>
        {% endfor %}
      </div>
      <h3 class="mt-2 text-[1rem] font-semibold leading-6 text-slate-950">{{ review.name }}</h3>
      <p class="mt-1 text-[13px] leading-5 text-slate-500">{{ review.date_label }}</p>
    </div>
    <span class="rspku-chip min-h-[2rem] min-w-[4.65rem] whitespace-nowrap px-3 text-[12px] font-semibold text-hospital-700">{{ review.rating }}.0 / 5</span>
  </div>

  <p class="mt-4 text-[14px] leading-7 text-slate-600">{{ review.excerpt }}</p>

  <a href="{{ review.source_url }}" target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 text-[14px] font-medium text-slate-900 transition hover:text-hospital-700">
    <svg aria-hidden="true" class="h-4 w-4 fill-current" viewBox="0 0 20 20">
      <path d="M6.25 4.5a1.25 1.25 0 0 0 0 2.5h4.982l-6.366 6.366a1.25 1.25 0 1 0 1.768 1.768L13 8.768v4.982a1.25 1.25 0 1 0 2.5 0v-8A1.25 1.25 0 0 0 14.25 4.5h-8Z"/>
    </svg>
    <span>{{ review.source_label }}</span>
  </a>
</article>

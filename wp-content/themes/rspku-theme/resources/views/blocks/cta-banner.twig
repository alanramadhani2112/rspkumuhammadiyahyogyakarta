<section class="rspku-section">
  <div class="rspku-container">
    <div class="rspku-card rounded-xl px-6 py-10 sm:px-10">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-hospital-700">Call to Action</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{{ attributes.title|default('Siap membangun CMS rumah sakit yang lebih rapi?') }}</h2>
          {% if attributes.description %}
            <p class="mt-3 text-base leading-7 text-slate-600">{{ attributes.description }}</p>
          {% endif %}
        </div>
        {% if attributes.ctaLabel and attributes.ctaUrl %}
          <a href="{{ attributes.ctaUrl }}" class="rspku-button rspku-button-primary">{{ icon('arrow-right', { class: 'h-4 w-4' }) }}<span>{{ attributes.ctaLabel }}</span></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

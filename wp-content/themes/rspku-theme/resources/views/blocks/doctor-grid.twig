<section class="rspku-section">
  <div class="rspku-container space-y-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-hospital-700">Dokter</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Koleksi dokter yang siap dipresentasikan dengan rapi</h2>
      </div>
    </div>

    {% if doctors %}
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {% for doctor in doctors %}
          {% include 'partials/doctor-card.twig' with {
            doctor: doctor,
            appointment_cta_text: rspku.doctor_appointment_cta_text|default('Buat janji'),
            appointment_fallback_url: rspku.doctor_appointment_fallback_url|default('/kontak/')
          } %}
        {% endfor %}
      </div>
    {% else %}
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-lg font-extrabold text-slate-950">Belum ada dokter yang cocok.</p>
      </div>
    {% endif %}
  </div>
</section>

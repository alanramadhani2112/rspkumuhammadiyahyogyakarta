{% if items %}
  <section class="rspku-section">
    <div class="rspku-container max-w-4xl space-y-6">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-hospital-700">FAQ</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">Pertanyaan yang sering ditanyakan</h2>
      </div>
      <div class="grid gap-3">
        {% for item in items %}
          <div class="rspku-card rounded-3xl p-5" x-data="accordionItem">
            <button type="button" class="flex w-full min-h-11 items-center justify-between gap-4 text-left font-extrabold text-slate-950" @click="toggle">
              <span>{{ item.question }}</span>
              <span x-text="open ? '-' : '+'"></span>
            </button>
            <div class="mt-3 text-sm leading-7 text-slate-600" x-cloak x-show="open">{{ item.answer }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

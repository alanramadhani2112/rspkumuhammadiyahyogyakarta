{#
  Table of Contents Component
  Fulfils spec R4. Two variants:
  - variant="desktop": Sticky sidebar with IntersectionObserver highlight
  - variant="mobile": Native <details> accordion, default collapsed

  Usage:
  {% include 'components/toc.twig' with {
    items: article_single.toc.items,
    variant: 'desktop'
  } only %}

  Props:
  - items (required): Nested array [{level, text, anchor, children}]
  - variant (optional): 'desktop' | 'mobile'. Default: 'desktop'.
#}

{% if items is not empty %}
  {% set variant = variant|default('desktop') %}

  {% if variant == 'mobile' %}
    <details class="mb-8 rounded-md border border-slate-200 bg-slate-50/50 xl:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 px-5 py-4 text-sm font-semibold text-slate-700">
        {{ icon('list-filter', { class: 'h-4 w-4 text-slate-400' }) }}
        <span class="flex-1">Daftar Isi</span>
        {{ icon('chevron-down', { class: 'h-4 w-4 text-slate-400 transition-transform' }) }}
      </summary>
      <nav class="rspku-toc border-t border-slate-200 px-5 py-4" aria-label="Daftar isi artikel">
        {% for item in items %}
          <a href="#{{ item.anchor }}" data-level="{{ item.level }}">{{ item.text }}</a>
          {% if item.children %}
            {% for child in item.children %}
              <a href="#{{ child.anchor }}" data-level="{{ child.level }}">{{ child.text }}</a>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </nav>
    </details>
  {% else %}
    <nav class="rounded-md border border-slate-200 bg-white p-5" aria-label="Daftar isi artikel" x-data="tocHighlight">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
        {{ icon('list-filter', { class: 'h-3.5 w-3.5' }) }}
        Daftar Isi
      </p>
      <div class="rspku-toc mt-3">
        {% for item in items %}
          <a href="#{{ item.anchor }}"
             data-level="{{ item.level }}"
             :class="active === '{{ item.anchor }}' ? 'is-active' : ''">{{ item.text }}</a>
          {% if item.children %}
            {% for child in item.children %}
              <a href="#{{ child.anchor }}"
                 data-level="{{ child.level }}"
                 :class="active === '{{ child.anchor }}' ? 'is-active' : ''">{{ child.text }}</a>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </nav>
  {% endif %}
{% endif %}

{#
  Empty State Component - No data/results display
  
  Usage:
  {% include 'components/empty-state.twig' with {
    title: 'Belum ada hasil',
    description: 'Coba gunakan kata kunci lain.',
    icon: 'search',
    action: {
      text: 'Cari lagi',
      url: '/',
      variant: 'primary'
    }
  } only %}
  
  Props:
  - title (required): Heading
  - description (optional): Explanation text
  - icon (optional): Icon name (default: 'inbox')
  - action (optional): Button object for CTA
  - variant (optional): 'default' | 'compact' (default: 'default')
#}

{% set icon_name = icon|default('inbox') %}
{% set variant = variant|default('default') %}

{% if variant == 'compact' %}
  <div class="flex items-center gap-4 rounded-lg border border-dashed border-slate-300 bg-white p-6">
    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-400">
      {{ icon(icon_name, { class: 'h-5 w-5' }) }}
    </div>
    <div class="flex-1">
      <p class="text-sm font-semibold text-slate-950">{{ title }}</p>
      {% if description %}
        <p class="mt-0.5 text-xs text-slate-600">{{ description }}</p>
      {% endif %}
    </div>
    {% if action %}
      {% include 'components/button.twig' with action|merge({ size: 'sm' }) only %}
    {% endif %}
  </div>
{% else %}
  <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center sm:p-12">
    <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-slate-100 text-slate-400">
      {{ icon(icon_name, { class: 'h-6 w-6' }) }}
    </div>
    <h3 class="mt-5 text-lg font-semibold text-slate-950">{{ title }}</h3>
    {% if description %}
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-600">{{ description }}</p>
    {% endif %}
    {% if action %}
      <div class="mt-5">
        {% include 'components/button.twig' with action|merge({ size: 'sm' }) only %}
      </div>
    {% endif %}
  </div>
{% endif %}

{#
  Accordion Component - Expandable content item
  
  Usage (single):
  {% include 'components/accordion.twig' with {
    title: 'Question here?',
    content: '<p>Answer content</p>',
    open: false
  } only %}
  
  Usage (multiple - wrap in parent):
  <div class="space-y-2">
    {% for item in items %}
      {% include 'components/accordion.twig' with {
        title: item.question,
        content: item.answer,
        icon: 'help-circle'
      } only %}
    {% endfor %}
  </div>
  
  Props:
  - title (required): Accordion heading
  - content (required): Body content (HTML)
  - open (optional): Default open state (default: false)
  - icon (optional): Icon name for header
  - variant (optional): 'default' | 'bordered' | 'minimal' (default: 'default')
#}

{% set is_open = open|default(false) %}
{% set variant = variant|default('default') %}

{% set wrapper_classes = {
  'default': 'rounded-lg border border-slate-200 bg-white',
  'bordered': 'rounded-lg border-2 border-slate-200 bg-white',
  'minimal': 'border-b border-slate-200'
} %}

<div class="{{ wrapper_classes[variant] }}" x-data="{ open: {{ is_open ? 'true' : 'false' }} }">
  <button
    type="button"
    class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left"
    @click="open = !open"
    :aria-expanded="open.toString()"
  >
    <div class="flex items-center gap-3">
      {% if icon %}
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-hospital-50 text-hospital-700">
          {{ icon(icon, { class: 'h-4 w-4' }) }}
        </span>
      {% endif %}
      <span class="text-sm font-semibold text-slate-950">{{ title }}</span>
    </div>
    <svg
      class="h-4 w-4 shrink-0 text-slate-400 transition-transform"
      :class="open ? 'rotate-180' : ''"
      fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 max-h-0"
    x-transition:enter-end="opacity-100 max-h-screen"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 max-h-screen"
    x-transition:leave-end="opacity-0 max-h-0"
    class="overflow-hidden border-t border-slate-100 px-5 py-4 text-sm leading-relaxed text-slate-600"
  >
    {{ content|raw }}
  </div>
</div>

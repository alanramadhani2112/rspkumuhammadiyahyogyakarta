{#
  Stat Card Component - Metric/statistic display
  
  Usage:
  {% include 'components/stat-card.twig' with {
    value: '75',
    label: 'Dokter terjadwal',
    description: 'Jumlah dokter yang tampil...',
    icon: 'calendar-days'
  } only %}
  
  Props:
  - value (required): Stat number/text (can be HTML for x-text binding)
  - value_bind (optional): Alpine x-text binding for dynamic value
  - label (required): Title/label above value
  - description (optional): Description below value
  - icon (optional): Icon name (shows next to label)
  - variant (optional): 'default' | 'gradient' | 'minimal' (default: 'default')
  - trend (optional): '+12%' or '-5%' for trend indicator
#}

{% set variant = variant|default('default') %}

{% if variant == 'gradient' %}
  <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-hospital-50 to-white p-6">
    <div class="flex items-center gap-2">
      {% if icon %}
        <div class="grid h-8 w-8 place-items-center rounded-lg bg-hospital-100 text-hospital-700">
          {{ icon(icon, { class: 'h-4 w-4' }) }}
        </div>
      {% endif %}
      <p class="text-sm font-medium text-slate-600">{{ label }}</p>
      {% if trend %}
        <span class="ml-auto rounded-full bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">{{ trend }}</span>
      {% endif %}
    </div>
    <p class="mt-3 text-4xl font-bold text-slate-950" {% if value_bind %}x-text="{{ value_bind }}"{% endif %}>{{ value }}</p>
    {% if description %}
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ description }}</p>
    {% endif %}
  </div>
{% elseif variant == 'minimal' %}
  <div>
    <div class="flex items-center gap-2">
      {% if icon %}{{ icon(icon, { class: 'h-4 w-4 text-hospital-700' }) }}{% endif %}
      <p class="text-sm font-medium text-slate-600">{{ label }}</p>
    </div>
    <p class="mt-2 text-3xl font-bold text-slate-950" {% if value_bind %}x-text="{{ value_bind }}"{% endif %}>{{ value }}</p>
    {% if description %}
      <p class="mt-1 text-sm text-slate-600">{{ description }}</p>
    {% endif %}
  </div>
{% else %}
  {# Default variant - Opsi B: Icon + label horizontal, angka dominan #}
  <div class="rounded-xl border border-slate-200 bg-white p-6 transition hover:border-hospital-200">
    <div class="flex items-center gap-2.5">
      {% if icon %}
        <div class="grid h-8 w-8 place-items-center rounded-lg bg-hospital-50 text-hospital-700">
          {{ icon(icon, { class: 'h-4 w-4' }) }}
        </div>
      {% endif %}
      <p class="text-sm font-medium text-slate-600">{{ label }}</p>
      {% if trend %}
        <span class="ml-auto rounded-full bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">{{ trend }}</span>
      {% endif %}
    </div>
    <p class="mt-4 text-4xl font-bold leading-none text-slate-950" {% if value_bind %}x-text="{{ value_bind }}"{% endif %}>{{ value }}</p>
    {% if description %}
      <p class="mt-3 text-sm leading-relaxed text-slate-600">{{ description }}</p>
    {% endif %}
  </div>
{% endif %}

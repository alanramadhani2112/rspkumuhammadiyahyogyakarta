{#
  Journal Card Component
  
  Usage:
  {% include 'components/journal-card.twig' with { item: item } only %}
  
  Props:
  - item.title (required): Journal title
  - item.url (required): Journal URL
  - item.excerpt (optional): Short description
  - item.date (optional): Publication date
  - item.file (optional): Object with url for PDF download
  - item.badge (optional): Badge text (default: 'Jurnal')
#}

{% set badge = item.badge|default('Jurnal') %}

<article class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:border-hospital-200">
  <div class="flex items-start justify-between gap-4">
    <span class="rounded-full bg-hospital-50 px-3 py-1 text-xs font-semibold text-hospital-700">{{ badge }}</span>
    {% if item.date %}
      <span class="text-xs text-slate-500">{{ item.date }}</span>
    {% endif %}
  </div>

  <div class="mt-5 flex-1 space-y-3">
    <h3 class="text-lg font-semibold leading-snug text-slate-950">
      <a href="{{ item.url }}" class="transition hover:text-hospital-700">{{ item.title }}</a>
    </h3>
    {% if item.excerpt %}
      <p class="text-sm leading-relaxed text-slate-600">{{ item.excerpt }}</p>
    {% endif %}
  </div>

  <div class="mt-6 flex flex-col gap-2">
    <a href="{{ item.url }}" class="rspku-button rspku-button-primary rspku-button-sm w-full">{{ icon('newspaper', { class: 'h-4 w-4' }) }}<span>Baca</span></a>
    {% if item.file is defined and item.file and item.file.url is defined %}
      <a href="{{ item.file.url }}" target="_blank" rel="noopener" class="rspku-button rspku-button-secondary rspku-button-sm w-full">{{ icon('download', { class: 'h-4 w-4' }) }}<span>Unduh PDF</span></a>
    {% endif %}
  </div>
</article>

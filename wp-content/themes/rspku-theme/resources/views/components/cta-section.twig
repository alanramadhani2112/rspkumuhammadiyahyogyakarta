{#
  CTA Section Component - Reusable call-to-action banner
  
  Usage (inline):
  {% include 'components/cta-section.twig' with {
    title: 'Butuh konsultasi?',
    description: 'Temukan dokter kami.',
    actions: [
      { text: 'Cari Dokter', url: '/dokter/', variant: 'primary', icon: 'search' }
    ],
    variant: 'inline'
  } only %}
  
  Props:
  - title (required): CTA heading
  - description (optional): CTA text
  - actions (required): Array of button props
  - variant: 'inline' | 'banner' | 'card' (default: 'card')
  - background: 'hospital' | 'white' | 'slate' | 'dark' (default: 'hospital')
  - eyebrow (optional): Small label above title
  - icon (optional): Icon name to show
#}

{% set variant = variant|default('card') %}
{% set background = background|default('hospital') %}

{% set bg_classes = {
  'hospital': 'border border-hospital-200 bg-hospital-50/50',
  'white': 'border border-slate-200 bg-white',
  'slate': 'border border-slate-200 bg-slate-50',
  'dark': 'bg-gradient-to-br from-hospital-600 to-hospital-700 text-white'
} %}

{% set text_color = background == 'dark' ? 'text-white' : 'text-slate-950' %}
{% set desc_color = background == 'dark' ? 'text-white/90' : 'text-slate-600' %}
{% set eyebrow_class = background == 'dark' ? 'bg-white/20 text-white' : 'bg-hospital-50 text-hospital-700' %}

{% if variant == 'banner' %}
  {# Full-width banner - used in page sections #}
  <section class="py-12">
    <div class="rspku-container">
      <div class="overflow-hidden rounded-xl {{ bg_classes[background] }} p-8 sm:p-12">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="space-y-4">
            {% if eyebrow %}
              <span class="inline-block rounded-full {{ eyebrow_class }} px-3 py-1 text-xs font-semibold">{{ eyebrow }}</span>
            {% endif %}
            <h2 class="text-2xl font-bold {{ text_color }} sm:text-3xl">{{ title }}</h2>
            {% if description %}
              <p class="max-w-2xl {{ desc_color }}">{{ description }}</p>
            {% endif %}
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
            {% for action in actions %}
              {% include 'components/button.twig' with action only %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% elseif variant == 'inline' %}
  {# Inline CTA - used inside content #}
  <div class="rounded-xl {{ bg_classes[background] }} p-6 sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        {% if icon %}
          <div class="mb-3 grid h-10 w-10 place-items-center rounded-lg bg-white text-hospital-700">
            {{ icon(icon, { class: 'h-5 w-5' }) }}
          </div>
        {% endif %}
        <h3 class="text-lg font-semibold {{ text_color }}">{{ title }}</h3>
        {% if description %}
          <p class="mt-1 text-sm {{ desc_color }}">{{ description }}</p>
        {% endif %}
      </div>
      <div class="flex flex-col gap-2 sm:flex-row sm:shrink-0">
        {% for action in actions %}
          {% include 'components/button.twig' with action|merge({ size: action.size|default('sm') }) only %}
        {% endfor %}
      </div>
    </div>
  </div>
{% else %}
  {# Card variant - centered, with eyebrow #}
  <div class="rounded-xl {{ bg_classes[background] }} p-8 text-center sm:p-12">
    {% if eyebrow %}
      <span class="inline-block rounded-full {{ eyebrow_class }} px-4 py-1 text-sm font-medium">{{ eyebrow }}</span>
    {% endif %}
    <h2 class="mt-4 text-2xl font-bold {{ text_color }} sm:text-3xl">{{ title }}</h2>
    {% if description %}
      <p class="mx-auto mt-4 max-w-2xl {{ desc_color }}">{{ description }}</p>
    {% endif %}
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {% for action in actions %}
        {% include 'components/button.twig' with action only %}
      {% endfor %}
    </div>
  </div>
{% endif %}

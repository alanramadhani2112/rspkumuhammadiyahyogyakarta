{#
  Service Card Component - For services/polyclinics
  
  Usage:
  {% include 'components/service-card.twig' with { item: item } only %}
  
  Props:
  - item.title (required): Service name
  - item.url (required): Service URL
  - item.excerpt (optional): Short description
  - item.icon (optional): Icon name (default: 'hospital')
  - item.link_text (optional): Link text (default: 'Lihat detail')
#}

{% set icon_name = item.icon|default('hospital') %}
{% set link_text = item.link_text|default('Lihat detail') %}

<a href="{{ item.url }}" class="group block rounded-xl border border-slate-200 bg-white p-6 transition hover:border-hospital-200">
  <div class="mb-4 grid h-11 w-11 place-items-center rounded-lg bg-hospital-50 text-hospital-700 transition group-hover:bg-hospital-600 group-hover:text-white group-focus-visible:bg-hospital-600 group-focus-visible:text-white">
    {{ icon(icon_name, { class: 'h-5 w-5 transition group-hover:text-white group-focus-visible:text-white' }) }}
  </div>
  <h3 class="text-lg font-semibold text-slate-950">{{ item.title }}</h3>
  {% if item.excerpt %}
    <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ item.excerpt }}</p>
  {% endif %}
  <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-hospital-700">
    <span>{{ link_text }}</span>
    {{ icon('arrow-right', { class: 'h-4 w-4 transition group-hover:translate-x-1' }) }}
  </div>
</a>

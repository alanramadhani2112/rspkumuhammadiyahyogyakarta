{% set fallback_icon = 'newspaper' %}
{% if item.badge|default('')|lower starts with 'manajemen' %}
  {% set fallback_icon = 'building-2' %}
{% endif %}

<article class="group flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:shadow-md">
  <a href="{{ item.url }}" class="block overflow-hidden bg-slate-100">
    {% if item.image.url %}
      <img src="{{ item.image.url }}" alt="{{ item.image.alt|default(item.title) }}" loading="lazy" class="aspect-[16/9] h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
    {% else %}
      <div class="grid aspect-[16/9] place-items-center bg-[radial-gradient(circle_at_top_right,_rgba(159,212,91,0.16),_transparent_32%),linear-gradient(180deg,#f8fbf8_0%,#eef6f0_100%)] p-8 text-center">
        <div class="space-y-4">
          <div class="mx-auto grid h-14 w-14 place-items-center rounded-lg border border-hospital-200 bg-white text-hospital-700">
            {{ icon(fallback_icon, { class: 'h-7 w-7' }) }}
          </div>
          <p class="text-sm font-medium text-hospital-700">{{ item.badge|default('Konten') }}</p>
        </div>
      </div>
    {% endif %}
  </a>
  <div class="flex flex-1 flex-col space-y-4 p-6">
    <h3 class="text-xl font-semibold leading-snug text-slate-950">
      <a href="{{ item.url }}" class="transition hover:text-hospital-700">{{ item.title }}</a>
    </h3>
    {% if item.excerpt %}
      <p class="text-sm leading-relaxed text-slate-600">{{ item.excerpt }}</p>
    {% endif %}
    <div class="mt-auto flex items-center justify-between gap-3 pt-2">
      <span class="rspku-badge text-hospital-700">{{ item.badge|default('Berita') }}</span>
      {% if item.date %}
        <span class="text-xs text-slate-500">{{ item.date }}</span>
      {% endif %}
    </div>
  </div>
</article>

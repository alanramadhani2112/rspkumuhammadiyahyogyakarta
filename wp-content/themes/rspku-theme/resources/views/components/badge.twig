{#
  Badge Component - Reusable chip/tag/label
  
  Usage:
  {% include 'components/badge.twig' with {
    text: 'Kategori',
    variant: 'primary',
    size: 'default'
  } only %}
  
  Props:
  - text (required): Badge text
  - variant (optional): 'default' | 'primary' | 'warning' | 'danger' | 'success' | 'neutral' (default: 'default')
  - size (optional): 'sm' | 'default' (default: 'default')
  - url (optional): Makes it a link
  - icon (optional): Icon name to prepend
#}

{% set variant = variant|default('default') %}
{% set size = size|default('default') %}

{% set variant_classes = {
  'default': 'bg-hospital-50 text-hospital-700',
  'primary': 'bg-hospital-600 text-white',
  'warning': 'bg-yellow-50 text-yellow-800',
  'danger': 'bg-red-50 text-red-700',
  'success': 'bg-green-50 text-green-700',
  'neutral': 'border border-slate-200 bg-white text-slate-600'
} %}

{% set size_classes = {
  'sm': 'px-2 py-0.5 text-[11px]',
  'default': 'px-3 py-1 text-xs'
} %}

{% set classes = 'inline-flex items-center gap-1.5 rounded-full font-semibold ' ~ variant_classes[variant] ~ ' ' ~ size_classes[size] %}

{% if url %}
  <a href="{{ url }}" class="{{ classes }} transition hover:opacity-80">
    {% if icon %}{{ icon(icon, { class: 'h-3 w-3' }) }}{% endif %}
    <span>{{ text }}</span>
  </a>
{% else %}
  <span class="{{ classes }}">
    {% if icon %}{{ icon(icon, { class: 'h-3 w-3' }) }}{% endif %}
    <span>{{ text }}</span>
  </span>
{% endif %}

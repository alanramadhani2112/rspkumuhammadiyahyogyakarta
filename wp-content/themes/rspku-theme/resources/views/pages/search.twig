{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="rspku-section pb-8">
    <div class="rspku-container space-y-10">
      {% include 'partials/breadcrumb.twig' with {
        items: [
          { title: 'Home', url: site.url },
          { title: 'Pencarian', current: true }
        ]
      } only %}

      <div class="grid gap-10 xl:grid-cols-[1fr_0.95fr] xl:items-end">
        <div class="space-y-6">
          <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ search_view.eyebrow|default('Pencarian') }}</span>
          <h1 class="max-w-3xl text-3xl font-bold leading-tight text-slate-950 sm:text-4xl lg:text-5xl">{{ search_view.title|default('Hasil pencarian') }}</h1>
          <p class="max-w-2xl text-base leading-relaxed text-slate-600">{{ search_view.description|default('Temukan konten yang paling relevan dengan kata kunci Anda.') }}</p>

          <form action="{{ search_view.search_action|default(site.url) }}" method="get" class="max-w-3xl">
            {% if search_view.post_type %}
              <input type="hidden" name="post_type" value="{{ search_view.post_type }}">
            {% endif %}
            {% if search_view.category_slug %}
              <input type="hidden" name="category_name" value="{{ search_view.category_slug }}">
            {% endif %}
            <div class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-2 sm:flex-row sm:items-center sm:rounded-full">
              <label for="global-search" class="sr-only">Cari konten di situs</label>
              <input id="global-search" type="search" name="s" value="{{ search_query }}" placeholder="Cari konten di sini" class="min-h-[3.75rem] flex-1 rounded-full px-5 text-base font-normal leading-6 text-slate-700 outline-none placeholder:text-[15px] placeholder:text-slate-400">
              <button type="submit" class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-hospital-600 text-white transition hover:bg-hospital-700" aria-label="Cari konten">
                {{ icon('search', { class: 'h-6 w-6' }) }}
              </button>
            </div>
          </form>
        </div>

        <div class="rounded-xl border border-slate-200 bg-hospital-50 p-8 sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Ringkasan</p>
          <p class="mt-5 text-[2.5rem] font-semibold leading-none text-slate-950">{{ posts|length }}</p>
          <p class="mt-4 max-w-sm text-lg leading-8 text-slate-600">Hasil yang ditemukan untuk kata kunci <span class="font-medium text-slate-950">"{{ search_query }}"</span>.</p>
        </div>
      </div>

      {% if posts %}
        <div class="rspku-divider"></div>

        <div class="grid gap-x-8 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
          {% for item in posts %}
            {% include 'components/content-card.twig' with {
              item: {
                title: item.title,
                url: item.link,
                excerpt: item.preview,
                image: item.thumbnail ? {
                  url: item.thumbnail.src('rspku-card'),
                  alt: item.title
                } : null,
                date: item.date,
                badge: 'Hasil'
              }
            } %}
          {% endfor %}
        </div>

        {% include 'partials/pagination.twig' with {
          pagination: pagination|default(''),
          class: 'pt-2',
          label: 'Pagination pencarian',
          total: pagination_meta.total|default(0),
          per_page: pagination_meta.per_page|default(10),
          current_page: pagination_meta.current_page|default(1),
          total_pages: pagination_meta.total_pages|default(1),
          show_single: pagination_meta.total|default(0) > 0,
          item_label: pagination_meta.item_label|default('hasil')
        } only %}
      {% else %}
        <div class="rspku-divider pt-8">
          <p class="text-lg font-semibold text-slate-950">Belum ada hasil ditemukan.</p>
          <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">Coba gunakan kata kunci yang lebih umum, periksa ejaan, atau ubah filter pencarian yang sedang dipakai.</p>
        </div>
      {% endif %}
    </div>
  </section>
{% endblock %}

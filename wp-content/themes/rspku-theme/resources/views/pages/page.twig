{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="rspku-section">
    <div class="rspku-container-narrow space-y-8">
      {% if post %}
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: post.title, current: true }
          ]
        } only %}

        <div class="space-y-4">
          <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Informasi</span>
          <h1 class="text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">{{ post.title }}</h1>
        </div>
        <div class="rspku-divider pt-8">
          <div class="rspku-prose">{{ post.content|raw }}</div>
        </div>
      {% endif %}
    </div>
  </section>
{% endblock %}

{% extends 'layouts/base.twig' %}

{% block content %}
  {% if polyclinic_archive is defined %}
    {% set lead = polyclinic_archive.lead %}

    {# Hero Section #}
    <section class="rspku-section pb-8">
      <div class="rspku-container">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Poliklinik', current: true }
          ]
        } only %}

        <div class="mt-6 grid gap-10 xl:grid-cols-[1fr_0.9fr] xl:items-end">
          <div class="space-y-4">
            <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Layanan Prima</span>
            <h1 class="text-3xl font-bold leading-tight text-slate-950 sm:text-4xl lg:text-5xl">Poliklinik RS PKU Yogyakarta</h1>
            <p class="max-w-2xl text-base leading-relaxed text-slate-600">Beragam layanan poliklinik kami untuk membantu Anda menemukan perawatan yang tepat sesuai kebutuhan medis.</p>

            {# Quick Stats #}
            <div class="flex flex-wrap gap-3 pt-2">
              <div class="inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2">
                {{ icon('hospital', { class: 'h-4 w-4 text-hospital-700' }) }}
                <span class="text-sm font-semibold text-slate-950">{{ polyclinic_archive.total }}</span>
                <span class="text-sm text-slate-500">poliklinik aktif</span>
              </div>
              <a href="{{ site.url }}/jadwal-dokter/" class="inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700">
                {{ icon('calendar-days', { class: 'h-4 w-4' }) }}
                <span>Jadwal dokter</span>
              </a>
              <a href="{{ site.url }}/dokter/" class="inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700">
                {{ icon('search', { class: 'h-4 w-4' }) }}
                <span>Cari dokter</span>
              </a>
            </div>
          </div>

          <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
            {% if rspku.image_poliklinik or rspku.image_poliklinik_url %}
              {% include 'partials/responsive-image.twig' with {
                id: rspku.image_poliklinik,
                url: rspku.image_poliklinik_url,
                alt: 'Poliklinik RS PKU Muhammadiyah Yogyakarta',
                class: 'aspect-[16/10] w-full object-cover',
                sizes: '(min-width: 1280px) 45vw, 100vw',
                width: 1200,
                height: 750,
                eager: true
              } only %}
            {% elseif lead and lead.image and lead.image.url %}
              {% include 'partials/responsive-image.twig' with {
                id: lead.image.id,
                url: lead.image.url,
                alt: lead.title,
                class: 'aspect-[16/10] w-full object-cover',
                sizes: '(min-width: 1280px) 45vw, 100vw',
                width: 1200,
                height: 750,
                eager: true
              } only %}
            {% else %}
              <div class="grid aspect-[16/10] place-items-center bg-[radial-gradient(circle_at_top_right,_rgba(159,212,91,0.18),_transparent_35%),linear-gradient(180deg,#f8fbf8_0%,#eef6f0_100%)] p-8 text-center">
                <div class="space-y-4">
                  <div class="mx-auto grid h-16 w-16 place-items-center rounded-lg border border-hospital-200 bg-white text-hospital-700">
                    {{ icon('stethoscope', { class: 'h-8 w-8' }) }}
                  </div>
                  <p class="text-lg font-semibold text-slate-700">Layanan poliklinik lengkap dengan dokter spesialis terpercaya</p>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {# Category Filter #}
    {% if polyclinic_archive.groups %}
      <section class="border-y border-slate-200 bg-slate-50/50 py-5">
        <div class="rspku-container">
          <div class="flex items-center gap-3 overflow-x-auto scrollbar-hide">
            <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-500">Kategori:</span>
            {% for group in polyclinic_archive.groups %}
              {% set first_item = group.items|first %}
              {% if first_item %}
                <a href="{{ first_item.url }}" class="shrink-0 rounded-sm border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-hospital-300 hover:bg-hospital-50 hover:text-hospital-700">{{ group.title }}</a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {# Polyclinic Grid #}
    {% if polyclinic_archive.items %}
      <section class="py-12">
        <div class="rspku-container">
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {% for item in polyclinic_archive.items %}
              <a href="{{ item.url }}" class="group flex h-full flex-col overflow-hidden rounded-md border border-slate-200 bg-white transition hover:border-hospital-300">
                {# Image / Icon Header #}
                <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
                  {% if item.image and item.image.url %}
                    <img src="{{ item.image.url }}" alt="{{ item.title }}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
                  {% else %}
                    <div class="grid h-full w-full place-items-center bg-hospital-50/30">
                      <div class="grid h-16 w-16 place-items-center rounded-sm border border-hospital-200 bg-white text-hospital-700">
                        {{ icon('stethoscope', { class: 'h-7 w-7' }) }}
                      </div>
                    </div>
                  {% endif %}
                  {# Category badge overlay #}
                  {% if item.group %}
                    <div class="absolute left-3 top-3">
                      <span class="inline-block rounded-sm bg-white/90 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700 backdrop-blur-sm">{{ item.group }}</span>
                    </div>
                  {% endif %}
                </div>

                {# Content #}
                <div class="flex flex-1 flex-col p-5">
                  <h2 class="text-base font-semibold leading-snug text-slate-950 transition group-hover:text-hospital-700">{{ item.title }}</h2>
                  {% if item.excerpt %}
                    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">{{ item.excerpt }}</p>
                  {% endif %}
                  <div class="mt-auto flex items-center justify-between gap-3 pt-4">
                    <span class="text-xs font-semibold uppercase tracking-wide text-hospital-700">Lihat detail</span>
                    <span class="grid h-7 w-7 place-items-center rounded-sm bg-hospital-50 text-hospital-700 transition group-hover:bg-hospital-600 group-hover:text-white">
                      {{ icon('arrow-up-right', { class: 'h-3.5 w-3.5' }) }}
                    </span>
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>

          {% include 'partials/pagination.twig' with {
            pagination: pagination|default(''),
            class: 'pt-10',
            label: 'Pagination poliklinik',
            total: pagination_meta.total|default(0),
            per_page: pagination_meta.per_page|default(10),
            current_page: pagination_meta.current_page|default(1),
            total_pages: pagination_meta.total_pages|default(1),
            show_single: pagination_meta.total|default(0) > 0,
            item_label: pagination_meta.item_label|default('poliklinik')
          } only %}
        </div>
      </section>
    {% endif %}

    {# CTA #}
    <section class="border-t border-slate-200 bg-slate-50/50 py-12">
      <div class="rspku-container">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-xl font-bold text-slate-950 sm:text-2xl">Tidak menemukan poliklinik yang Anda cari?</h2>
          <p class="mx-auto mt-2 max-w-xl text-sm text-slate-600">Tim kami siap membantu mengarahkan Anda ke layanan yang tepat.</p>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            {% include 'components/button.twig' with {
              text: 'Hubungi Kami',
              url: site.url ~ '/kontak/',
              variant: 'primary',
              icon: 'phone'
            } only %}
            {% include 'components/button.twig' with {
              text: 'Cari Dokter',
              url: site.url ~ '/dokter/',
              variant: 'secondary',
              icon: 'search'
            } only %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

{% extends 'layouts/base.twig' %}

{% block content %}
  {% if journal_landing is defined %}
    {% set featured = journal_landing.featured %}
    <section class="rspku-section pb-8">
      <div class="rspku-container space-y-12">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: journal_landing.title, current: true }
          ]
        } only %}

        <div class="grid gap-10 xl:grid-cols-[1fr_0.9fr] xl:items-end">
          <div class="space-y-6">
            <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Jurnal</span>
            <h1 class="max-w-4xl text-3xl font-bold leading-tight text-slate-950 sm:text-4xl lg:text-5xl">{{ journal_landing.title }}</h1>
            <p class="max-w-3xl text-base leading-relaxed text-slate-600">{{ journal_landing.description }}</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
      <div class="border border-slate-200 bg-hospital-50 p-6">
              <p class="text-sm font-medium text-hospital-700">Publikasi aktif</p>
              <p class="mt-3 text-[2rem] font-semibold leading-none text-slate-950">{{ journal_landing.total }}</p>
              <p class="mt-3 text-[15px] leading-7 text-slate-600">Arsip jurnal tersusun rapi untuk dibaca ulang dan dibagikan kembali.</p>
            </div>
            <div class="border border-slate-200 bg-white p-6">
              <p class="text-sm font-medium text-hospital-700">Dokumen siap unduh</p>
              <p class="mt-3 text-[2rem] font-semibold leading-none text-slate-950">{{ journal_landing.documents }}</p>
              <p class="mt-3 text-[15px] leading-7 text-slate-600">Tautan PDF akan tetap muncul langsung pada kartu ketika tersedia.</p>
            </div>
          </div>
        </div>

        {% if featured %}
          <div class="rspku-divider pt-8">
            <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
              <div class="space-y-4">
                <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Sorotan terbaru</span>
                <h2 class="max-w-3xl text-[1.75rem] font-semibold leading-tight text-slate-950">{{ featured.title }}</h2>
                {% if featured.excerpt %}
                  <p class="max-w-2xl text-[15px] leading-8 text-slate-600">{{ featured.excerpt }}</p>
                {% endif %}
              </div>
              <div class="flex flex-wrap gap-3 lg:justify-end">
                {% include 'components/button.twig' with {
                  text: 'Baca jurnal',
                  url: featured.url,
                  variant: 'primary'
                } only %}
                {% if featured.file and featured.file.url %}
                  {% include 'components/button.twig' with {
                    text: 'Unduh PDF',
                    url: featured.file.url,
                    variant: 'secondary',
                    target: '_blank',
                    icon: 'download'
                  } only %}
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}

        {% if journal_landing.items %}
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {% for item in journal_landing.items %}
              {% include 'components/journal-card.twig' with { item: item } only %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}
{% endblock %}

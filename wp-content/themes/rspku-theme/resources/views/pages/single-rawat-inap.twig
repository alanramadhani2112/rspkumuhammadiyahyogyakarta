{% extends 'layouts/base.twig' %}

{% block content %}
  {% if room_single %}
    <section class="rspku-section pb-10">
      <div class="rspku-container space-y-10">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Fasilitas Rawat Inap', url: site.url ~ '/fasilitas-rawat-inap/' },
            { title: room_single.title, current: true }
          ]
        } only %}

        <div class="grid gap-10 xl:grid-cols-[minmax(0,1fr)_22rem] xl:items-start">
          <div class="space-y-8">
            <header class="space-y-5">
              {% include 'components/section-header.twig' with {
                icon: 'building-2',
                title: 'Rawat inap',
                size: 'large'
              } only %}
              <h1 class="max-w-4xl text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl xl:text-[3.35rem]">{{ room_single.title }}</h1>
              {% if room_single.excerpt %}
                <p class="max-w-3xl text-lg leading-relaxed text-slate-600">{{ room_single.excerpt }}</p>
              {% endif %}
            </header>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {% include 'components/info-card.twig' with {
                icon: 'tag',
                label: 'Kategori',
                value: room_single.category|default('-', true)
              } only %}
              {% include 'components/info-card.twig' with {
                icon: 'bed-double',
                label: 'Tempat tidur',
                value: room_single.bed_count|default('-', true)
              } only %}
              {% include 'components/info-card.twig' with {
                icon: 'maximize',
                label: 'Luas kamar',
                value: room_single.size|default('-', true)
              } only %}
              {% include 'components/info-card.twig' with {
                icon: 'banknote',
                label: 'Tarif per hari',
                value: room_single.rate ? 'Rp ' ~ room_single.rate : '-'
              } only %}
            </div>

            {% if room_single.image and room_single.image.url %}
              <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
                <img src="{{ room_single.image.url }}" alt="{{ room_single.title }}" loading="lazy" class="aspect-[16/9] w-full object-cover">
              </div>
            {% endif %}

            {% if room_single.gallery|length > 1 %}
              <div class="grid gap-4 sm:grid-cols-3">
                {% for image in room_single.gallery|slice(1, 3) %}
                  <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
                    <img src="{{ image.url }}" alt="{{ image.alt|default(room_single.title) }}" loading="lazy" class="aspect-[4/3] w-full object-cover">
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if room_single.content %}
              <div class="rspku-prose max-w-none">{{ room_single.content|raw }}</div>
            {% endif %}

            {% if room_single.features or room_single.included %}
              <div class="space-y-6">
                {% if room_single.features %}
                  <section>
                    <div class="flex items-center gap-2.5 mb-4">
                      <div class="grid h-8 w-8 place-items-center rounded-lg bg-hospital-50 text-hospital-700">
                        {{ icon('check-circle', { class: 'h-4 w-4' }) }}
                      </div>
                      <h2 class="text-base font-semibold text-slate-900">Fasilitas kamar</h2>
                    </div>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
                      {% for item in room_single.features %}
                        <div class="flex items-center gap-2 py-1.5 text-sm text-slate-600">
                          <div class="grid h-4 w-4 shrink-0 place-items-center text-hospital-600">
                            {{ icon('check', { class: 'h-3.5 w-3.5' }) }}
                          </div>
                          <span>{{ item }}</span>
                        </div>
                      {% endfor %}
                    </div>
                  </section>
                {% endif %}
                {% if room_single.included %}
                  <section class="border-t border-slate-200 pt-6">
                    <div class="flex items-center gap-2.5 mb-4">
                      <div class="grid h-8 w-8 place-items-center rounded-lg bg-hospital-50 text-hospital-700">
                        {{ icon('package-check', { class: 'h-4 w-4' }) }}
                      </div>
                      <h2 class="text-base font-semibold text-slate-900">Sudah termasuk</h2>
                    </div>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
                      {% for item in room_single.included %}
                        <div class="flex items-center gap-2 py-1.5 text-sm text-slate-600">
                          <div class="grid h-4 w-4 shrink-0 place-items-center text-hospital-600">
                            {{ icon('check', { class: 'h-3.5 w-3.5' }) }}
                          </div>
                          <span>{{ item }}</span>
                        </div>
                      {% endfor %}
                    </div>
                  </section>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <aside class="space-y-5 xl:sticky xl:top-28 xl:self-start">
            <section class="rspku-side-panel">
              {% include 'components/section-header.twig' with {
                icon: 'info',
                title: 'Informasi kamar'
              } only %}
              <div class="mt-6 space-y-6">
                {% include 'components/info-item.twig' with {
                  icon: 'tag',
                  label: 'Kategori',
                  value: room_single.category|default('-', true)
                } only %}
                {% include 'components/info-item.twig' with {
                  icon: 'bed-double',
                  label: 'Tempat tidur',
                  value: room_single.bed_count|default('-', true)
                } only %}
                {% include 'components/info-item.twig' with {
                  icon: 'maximize',
                  label: 'Luas kamar',
                  value: room_single.size|default('-', true)
                } only %}
                {% include 'components/info-item.twig' with {
                  icon: 'banknote',
                  label: 'Tarif per hari',
                  value: room_single.rate ? 'Rp ' ~ room_single.rate : '-'
                } only %}
              </div>
              <div class="mt-6 pt-6 border-t border-slate-200">
                {% include 'components/button.twig' with {
                  text: 'Hubungi admisi',
                  url: site.url ~ '/kontak/',
                  variant: 'primary',
                  icon: 'phone',
                  full_width: true
                } only %}
              </div>
            </section>
          </aside>
        </div>

        {% if room_related %}
          <div class="rspku-divider"></div>
          <section class="space-y-8">
            <div>
              <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Pilihan lain</span>
              <h2 class="mt-3 text-2xl font-bold leading-tight text-slate-950 sm:text-3xl">Kamar rawat inap lainnya</h2>
            </div>
            <div class="grid gap-8 xl:grid-cols-3">
              {% for item in room_related %}
                {% include 'components/content-card.twig' with {
                  item: item|merge({
                    badge: 'Rawat inap'
                  })
                } %}
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>
    </section>
  {% else %}
    {% include 'partials/content-not-found.twig' with {
      title: 'Informasi kamar tidak ditemukan',
      description: 'Detail kamar rawat inap yang Anda cari tidak tersedia atau sudah dipindahkan.',
      back_url: site.url ~ '/fasilitas-rawat-inap/',
      back_label: 'Kembali ke daftar fasilitas'
    } only %}
  {% endif %}
{% endblock %}

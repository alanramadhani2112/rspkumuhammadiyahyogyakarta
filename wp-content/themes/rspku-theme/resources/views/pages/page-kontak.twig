{% extends 'layouts/base.twig' %}

{% block content %}
  {% if contact_page is defined %}
    <section class="rspku-section pb-8">
      <div class="rspku-container space-y-10">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Kontak', current: true }
          ]
        } only %}

        <div class="grid gap-10 xl:grid-cols-[0.92fr_1.08fr] xl:items-start">
          <div class="space-y-6">
            <span class="rspku-eyebrow">{{ contact_page.eyebrow }}</span>
            <h1 class="max-w-3xl text-[2.25rem] font-semibold leading-[1.08] text-slate-950 sm:text-[2.75rem] xl:text-[3.25rem]">{{ contact_page.title }}</h1>
            <p class="max-w-2xl text-base leading-8 text-slate-600">{{ contact_page.description }}</p>

            <div class="flex flex-wrap gap-3">
              {% include 'components/button.twig' with {
                text: 'Telepon utama',
                url: 'tel:+62274512653',
                variant: 'primary',
                icon: 'phone'
              } only %}
              {% include 'components/button.twig' with {
                text: 'Kirim email',
                url: 'mailto:info@rspkudev.test',
                variant: 'secondary',
                icon: 'mail'
              } only %}
            </div>
          </div>

          <div class="overflow-hidden border border-slate-200 bg-slate-100">
            <iframe src="{{ contact_page.map_embed_url }}" title="Lokasi RS PKU Muhammadiyah Yogyakarta" class="h-[24rem] w-full border-0 sm:h-[30rem]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>

        <div class="rspku-divider"></div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {% for item in contact_page.cards %}
            <article class="border border-slate-200 bg-white p-6">
              <div class="grid h-12 w-12 place-items-center border border-hospital-200 bg-[#f8fbf8] text-hospital-700">
                {{ icon(item.icon, { class: 'h-6 w-6' }) }}
              </div>
              <h2 class="mt-5 text-[1.35rem] font-semibold leading-tight text-slate-950">{{ item.title }}</h2>
              {% if item.body %}
                <p class="mt-4 text-[15px] leading-7 text-slate-600">{{ item.body }}</p>
              {% endif %}
              {% if item.lines %}
                <div class="mt-4 space-y-2 text-[15px] leading-7 text-slate-600">
                  {% for line in item.lines %}
                    <p>{{ line }}</p>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <article class="border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-3">
              <div class="grid h-12 w-12 place-items-center border border-hospital-200 bg-[#f8fbf8] text-hospital-700">
                {{ icon('calendar-days', { class: 'h-6 w-6' }) }}
              </div>
              <div>
                <p class="text-sm font-medium text-hospital-700">Jam layanan rumah sakit</p>
                <h2 class="mt-1 text-[1.35rem] font-semibold text-slate-950">Jam operasional</h2>
              </div>
            </div>

            <div class="mt-5 space-y-3 text-[15px] leading-7 text-slate-600">
              {% for line in contact_page.service_hours %}
                <p>{{ line }}</p>
              {% endfor %}
            </div>
          </article>

          <article class="border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-3">
              <div class="grid h-12 w-12 place-items-center border border-hospital-200 bg-[#f8fbf8] text-hospital-700">
                {{ icon('share-2', { class: 'h-6 w-6' }) }}
              </div>
              <div>
                <p class="text-sm font-medium text-hospital-700">Media sosial resmi</p>
                <h2 class="mt-1 text-[1.35rem] font-semibold text-slate-950">Kanal informasi</h2>
              </div>
            </div>

            <div class="mt-5 space-y-3 text-[15px] leading-7 text-slate-600">
              {% for line in contact_page.socials %}
                <p>{{ line }}</p>
              {% endfor %}
            </div>
          </article>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

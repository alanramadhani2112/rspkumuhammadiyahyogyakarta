{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="rspku-section pb-10 rspku-schedule-page" x-data="scheduleTable">
    <div class="rspku-container space-y-10">
      {% include 'partials/breadcrumb.twig' with {
        items: [
          { title: 'Home', url: site.url },
          { title: post.title, current: true }
        ]
      } only %}

      <div class="grid gap-10 xl:grid-cols-[1.05fr_0.95fr] xl:items-end">
        <div class="space-y-6">
          <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Jadwal layanan</span>
          <h1 class="text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">{{ post.title }}</h1>
          <p class="max-w-2xl text-base leading-relaxed text-slate-600">Cek jadwal praktik dokter RS PKU Muhammadiyah Yogyakarta, lalu pilih waktu kunjungan yang paling sesuai untuk Anda.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {% include 'components/stat-card.twig' with {
            icon: 'calendar-days',
            label: 'Dokter terjadwal',
            value: schedule_page.summary.doctor_count|default(0),
            value_bind: 'visibleRows',
            description: 'Dokter yang dapat Anda temukan sesuai pencarian dan pilihan spesialisasi.'
          } only %}

          {% include 'components/stat-card.twig' with {
            icon: 'filter',
            label: 'Kategori spesialisasi',
            value: schedule_page.summary.specialization_count|default(0),
            description: 'Pilih spesialisasi untuk melihat dokter yang sesuai kebutuhan Anda.'
          } only %}
        </div>
      </div>

      <div class="rspku-divider"></div>

      <div class="grid gap-4 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.8fr)_auto] lg:items-end">
        <div class="space-y-2">
          <label for="schedule-search" class="block text-sm font-medium text-slate-600">Cari dokter atau spesialisasi</label>
          <input id="schedule-search" x-model="query" @input.debounce.250ms="query = $event.target.value; filterRows()" @keydown.enter.prevent="query = $event.target.value; filterRows()" type="search" placeholder="Contoh: dr. H. Zamroni, Penyakit Saraf" class="rspku-schedule-input">
        </div>

        <div class="space-y-2">
          <label id="schedule-specialization-label" for="schedule-specialization" class="block text-sm font-medium text-slate-600">Filter spesialisasi</label>
          <div class="rspku-searchable-select" x-data="searchableSelect">
            <select id="schedule-specialization" x-model="specialization" x-ref="specialization" @change="filterRows" class="rspku-schedule-select rspku-searchable-select-native" tabindex="-1" aria-hidden="true" aria-labelledby="schedule-specialization-label">
              <option value="">Semua spesialisasi</option>
              {% for group in schedule_page.specialization_groups|default([]) %}
                <optgroup label="{{ group.title }}">
                  {% for item in group.items %}
                    <option value="{{ item.slug }}">{{ item.name }}</option>
                  {% endfor %}
                </optgroup>
              {% endfor %}
            </select>
            <button type="button" class="rspku-searchable-select-trigger rspku-schedule-select" @click="toggle" @keydown.enter.prevent="openList" @keydown.space.prevent="openList" @keydown.arrow-down.prevent="openList" @keydown.arrow-up.prevent="openList" @keydown.escape.prevent="close" :aria-expanded="open.toString()" aria-haspopup="listbox" aria-labelledby="schedule-specialization-label" aria-controls="schedule-specialization-listbox">
              <span x-text="selectedLabel"></span>
            </button>
            <div class="rspku-searchable-select-panel" x-show="open" x-cloak @click.outside="close">
              <input type="search" class="rspku-searchable-select-search" x-model="query" x-ref="search" @input="highlightedIndex = 0" @keydown.escape.prevent="close" @keydown.arrow-down.prevent="next" @keydown.arrow-up.prevent="previous" @keydown.enter.prevent="chooseHighlighted" placeholder="Cari spesialisasi" aria-labelledby="schedule-specialization-label">
              <ul id="schedule-specialization-listbox" class="rspku-searchable-select-list" role="listbox" aria-labelledby="schedule-specialization-label">
                <template x-for="(option, index) in filteredOptions" :key="option.value">
                  <li>
                    <button type="button" class="rspku-searchable-select-option" :class="{ 'is-active': index === highlightedIndex, 'is-selected': option.value === value }" role="option" :aria-selected="(option.value === value).toString()" @mouseenter="highlightedIndex = index" @click="choose(option)" x-text="option.label"></button>
                  </li>
                </template>
                <li class="rspku-searchable-select-empty" x-show="filteredOptions.length === 0">Spesialisasi tidak ditemukan</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="flex gap-3 lg:justify-end">
          <button type="button" class="rspku-button rspku-button-primary h-14 px-6" @click="filterRows">
            {{ icon('search', { class: 'h-4 w-4' }) }}
            <span>Cari</span>
          </button>
          <button type="button" class="rspku-button rspku-button-secondary h-14 px-5" @click="reset">Reset</button>
        </div>
      </div>

      <div class="flex flex-col gap-3 text-[15px] text-slate-600 lg:flex-row lg:items-center lg:justify-between">
        <p>Jadwal dapat berubah sewaktu-waktu. Silakan cek kembali sebelum berkunjung.</p>
        <div class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-200 bg-[#f7faf7] px-4 text-sm">
          {{ icon('calendar-days', { class: 'h-4 w-4 text-hospital-600' }) }}
          <span>Geser tabel ke samping pada layar kecil</span>
        </div>
      </div>

      {% if schedule_page.rows %}
        <div class="rspku-schedule-table-shell">
          <div class="rspku-schedule-table-wrap">
            <table class="rspku-schedule-table" aria-label="Jadwal Pelayanan Poliklinik">
              <thead>
                <tr>
                  <th class="column-doctor">Dokter</th>
                  {% for day in schedule_page.day_headers %}
                    <th>{{ day.label }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in schedule_page.rows %}
                  <tr
                    data-schedule-row
                    data-schedule-name="{{ row.name|lower|e('html_attr') }}"
                    data-schedule-specialization="{{ row.specialization_slugs|default([row.specialization_slug])|join(' ')|e('html_attr') }}"
                    data-schedule-category="{{ row.specialization_category_slug|e('html_attr') }}"
                  >
                    <th scope="row" class="column-doctor">
                      <div class="space-y-2">
                        <p class="text-sm font-semibold leading-snug text-slate-950">{{ row.name }}</p>
                        <span class="rspku-schedule-badge">{{ row.specialization }}</span>
                      </div>
                    </th>
                    {% for day in schedule_page.day_headers %}
                      {% set dayCell = row.days[day.key] %}
                      <td>
                        {% if dayCell and dayCell.slots %}
                          <div class="space-y-2">
                            {% for slot in dayCell.slots %}
                              <div class="rspku-schedule-slot">{{ slot.label }}</div>
                            {% endfor %}
                          </div>
                        {% else %}
                          <span class="rspku-schedule-empty">-</span>
                        {% endif %}
                      </td>
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        <div class="rspku-pagination-shell pt-5" x-show="visibleRows > 0">
          <p class="rspku-pagination-summary" x-text="`Menampilkan ${pageStart()}-${pageEnd()} dari ${visibleRows} dokter`">Menampilkan data dokter.</p>
          <nav class="rspku-pagination-links rspku-table-pagination" aria-label="Pagination jadwal dokter">
            <button type="button" class="rspku-pagination-button" x-show="totalPages() > 1" :disabled="currentPage <= 1" @click="goToPage(currentPage - 1)">Sebelumnya</button>
            <template x-for="page in pages()" :key="page">
              <button type="button" class="rspku-pagination-button" :class="page === currentPage ? 'is-active' : ''" @click="goToPage(page)" x-text="page"></button>
            </template>
            <button type="button" class="rspku-pagination-button" x-show="totalPages() > 1" :disabled="currentPage >= totalPages()" @click="goToPage(currentPage + 1)">Berikutnya</button>
          </nav>
        </div>
        <p class="rspku-pagination-summary pt-5" x-show="visibleRows === 0">Belum ada dokter yang cocok dengan filter yang dipilih.</p>
      {% else %}
        <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
          <p class="text-lg font-semibold text-slate-950">Jadwal dokter belum tersedia.</p>
          <p class="mt-2 text-[15px] leading-7 text-slate-600">Silakan periksa kembali data tabel jadwal dokter di sumber utama.</p>
        </div>
      {% endif %}
    </div>
  </section>
{% endblock %}

{% extends 'layouts/base.twig' %}

{% block content %}
  {% if polyclinic is defined and polyclinic %}
    {% embed 'partials/single-cpt-shell.twig' with {
      breadcrumb_items: [
        { title: 'Home', url: site.url },
        { title: 'Poliklinik', url: site.url ~ '/poliklinik/' },
        { title: polyclinic.title, current: true }
      ],
      eyebrow: polyclinic.group,
      title: polyclinic.title,
      excerpt: polyclinic.excerpt,
      image: polyclinic.image,
      image_class: 'aspect-[16/9]',
      fallback_icon: 'stethoscope',
      content: polyclinic.content,
      grid_class: 'grid gap-10 xl:grid-cols-[16rem_minmax(0,1fr)_22rem] xl:items-start'
    } %}
      {% block before_grid %}
        <details class="rounded-lg border border-slate-200 bg-white p-5 xl:hidden">
          <summary class="cursor-pointer list-none text-base font-semibold text-slate-950">Daftar poliklinik</summary>
          <div class="mt-5 space-y-6">
            {% for group in polyclinic_navigation %}
              <div class="space-y-3">
                <h2 class="text-lg font-semibold text-hospital-700">{{ group.title }}</h2>
                <div class="flex flex-wrap gap-2">
                  {% for item in group.items %}
                    <a href="{{ item.url }}" class="rounded-sm border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700 {{ item.id == polyclinic.id ? 'border-hospital-300 bg-hospital-50 text-hospital-700' : '' }}" {{ item.id == polyclinic.id ? 'aria-current="page"' : '' }}>{{ item.title }}</a>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </details>
      {% endblock %}

      {% block leading_sidebar %}
        <aside class="hidden xl:block">
          <div class="sticky top-28 max-h-[calc(100vh-8rem)] space-y-8 overflow-y-auto pr-3">
            {% for group in polyclinic_navigation %}
              <section class="rspku-side-nav-group {{ loop.first ? 'border-t-0 pt-0' : '' }}">
                <h2 class="rspku-side-nav-title">{{ group.title }}</h2>
                <div class="mt-4 space-y-3">
                  {% for item in group.items %}
                    <a href="{{ item.url }}" class="rspku-side-nav-link {{ item.id == polyclinic.id ? 'is-active' : '' }}" {{ item.id == polyclinic.id ? 'aria-current="page"' : '' }}>{{ item.title }}</a>
                  {% endfor %}
                </div>
              </section>
            {% endfor %}
          </div>
        </aside>
      {% endblock %}

      {% block after_content %}
        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          {% include 'components/button.twig' with {
            text: 'Cari dokter',
            url: site.url ~ '/dokter/',
            variant: 'primary',
            class: 'px-8'
          } only %}
          {% include 'components/button.twig' with {
            text: 'Lihat jadwal dokter',
            url: site.url ~ '/jadwal-dokter/',
            variant: 'secondary',
            class: 'px-8'
          } only %}
        </div>
      {% endblock %}

      {% block sidebar %}
        {% include 'partials/related-doctors-panel.twig' with {
          site: site,
          doctors: polyclinic_doctors,
          eyebrow: 'Dokter terkait',
          title: 'Jadwal dan profil dokter'
        } only %}
      {% endblock %}
    {% endembed %}
  {% else %}
    {% include 'partials/content-not-found.twig' with {
      title: 'Poliklinik tidak ditemukan',
      description: 'Informasi poliklinik yang Anda cari tidak tersedia atau sudah dipindahkan.',
      back_url: site.url ~ '/poliklinik/',
      back_label: 'Kembali ke daftar poliklinik'
    } only %}
  {% endif %}
{% endblock %}

{% extends 'layouts/base.twig' %}

{% block content %}
  {% if service_single %}
    {% set primary_category = service_single.primary_category %}
    {% set eyebrow = primary_category ? primary_category.name : 'Layanan medis' %}
    {% set breadcrumb_items = [
      { title: 'Home', url: site.url },
      { title: 'Semua layanan medis', url: site.url ~ '/layanan/' }
    ] %}
    {% if primary_category %}
      {% set breadcrumb_items = breadcrumb_items|merge([{ title: primary_category.name, url: primary_category.url }]) %}
    {% endif %}
    {% set breadcrumb_items = breadcrumb_items|merge([{ title: service_single.title, current: true }]) %}

    {% embed 'partials/single-cpt-shell.twig' with {
      breadcrumb_items: breadcrumb_items,
      eyebrow: eyebrow,
      title: service_single.title,
      excerpt: service_single.excerpt,
      image: service_single.image,
      image_class: 'aspect-[16/9]',
      content: service_single.content
    } %}
      {% block sidebar %}
        <section class="rspku-side-panel">
          <p class="text-sm font-medium text-slate-500">Ringkasan layanan</p>
          <div class="mt-5 space-y-4">
            <div>
              <p class="text-[13px] font-medium uppercase tracking-[0.06em] text-slate-500">Kategori</p>
              <p class="mt-2 text-[15px] font-semibold text-slate-950">{{ eyebrow }}</p>
            </div>
            <div>
              <p class="text-[13px] font-medium uppercase tracking-[0.06em] text-slate-500">Aksi cepat</p>
              <div class="mt-3 flex flex-col gap-3">
                {% include 'components/button.twig' with {
                  text: 'Cari dokter',
                  url: site.url ~ '/dokter/',
                  variant: 'primary',
                  full_width: true
                } only %}
                {% include 'components/button.twig' with {
                  text: 'Hubungi rumah sakit',
                  url: site.url ~ '/kontak/',
                  variant: 'secondary',
                  full_width: true
                } only %}
              </div>
            </div>
          </div>
        </section>

        {% include 'partials/related-doctors-panel.twig' with {
          site: site,
          doctors: service_doctors,
          eyebrow: 'Dokter terkait',
          title: 'Jadwal dan profil dokter',
          description: 'Data dokter mengikuti sinkronisasi jadwal praktik resmi.'
        } only %}
      {% endblock %}

      {% block related %}
        {% if service_related %}
          <div class="rspku-divider"></div>
          <section class="space-y-8">
            <div>
              <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Layanan lain</span>
              <h2 class="mt-3 text-2xl font-bold leading-tight text-slate-950 sm:text-3xl">Layanan yang masih berkaitan</h2>
            </div>
            <div class="grid gap-8 xl:grid-cols-3">
              {% for item in service_related %}
                {% include 'components/content-card.twig' with {
                  item: item|merge({
                    badge: 'Layanan medis'
                  })
                } %}
              {% endfor %}
            </div>
          </section>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% else %}
    {% include 'partials/content-not-found.twig' with {
      title: 'Layanan tidak ditemukan',
      description: 'Layanan medis yang Anda cari tidak tersedia atau sudah dipindahkan.',
      back_url: site.url ~ '/layanan/',
      back_label: 'Kembali ke daftar layanan'
    } only %}
  {% endif %}
{% endblock %}

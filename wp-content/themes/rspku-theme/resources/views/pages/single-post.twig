{% extends 'layouts/base.twig' %}

{% block content %}
  {% if article_single is defined %}
    {% set primary_category = article_single.primary_category %}
    {% set breadcrumb_items = [{ title: 'Home', url: site.url }, { title: 'Berita & Artikel', url: site.url ~ '/berita-artikel/' }] %}
    {% if primary_category %}
      {% set breadcrumb_items = breadcrumb_items|merge([{ title: primary_category.name, url: primary_category.url }]) %}
    {% endif %}
    {% set breadcrumb_items = breadcrumb_items|merge([{ title: post.title, current: true }]) %}

    <article class="rspku-section pb-10">
      <div class="rspku-container space-y-8">
        {% include 'partials/breadcrumb.twig' with { items: breadcrumb_items } only %}

        <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="min-w-0 space-y-8">
            <header class="space-y-5">
              <div class="flex flex-wrap items-center gap-3 text-sm leading-normal text-slate-500">
                {% if primary_category %}
                  <span class="rspku-chip min-h-[2rem] px-3 text-xs font-semibold text-hospital-700">{{ primary_category.name }}</span>
                {% endif %}
                <span>{{ post.date('j M Y') }}</span>
                {% if post.modified and post.modified != post.date %}
                  <span>• Diperbarui: {{ post.modified('j M Y') }}</span>
                {% endif %}
                {% if post.reading_time %}
                  <span>• 📖 {{ post.reading_time }} min baca</span>
                {% endif %}
              </div>
              <h1 class="rspku-page-title max-w-4xl font-semibold text-slate-950">{{ post.title }}</h1>
              <div class="flex items-center gap-3">
                {% if post.author.avatar %}
                  <img src="{{ post.author.avatar }}" alt="{{ post.author.name }}" class="h-10 w-10 rounded-full">
                {% else %}
                  <div class="grid h-10 w-10 place-items-center rounded-full bg-hospital-100 text-sm font-semibold text-hospital-700">
                    {{ post.author.name|slice(0, 1)|upper }}
                  </div>
                {% endif %}
                <div class="text-sm">
                  <p class="font-semibold text-slate-950">{{ post.author.name|default('Tim RS PKU') }}</p>
                  {% if post.author.description %}
                    <p class="text-slate-600">{{ post.author.description|slice(0, 60) }}...</p>
                  {% endif %}
                </div>
              </div>
              {% if post.preview %}
                <p class="rspku-section-lead max-w-3xl">{{ post.preview }}</p>
              {% endif %}
            </header>

            {% if post.thumbnail %}
              <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
                <img src="{{ post.thumbnail.src('rspku-hero') }}" alt="{{ post.title }}" loading="lazy" class="aspect-[16/9] w-full object-cover">
              </div>
            {% endif %}

            <div class="rspku-prose max-w-none">{{ post.content|raw }}</div>

            {# Tags section #}
            {% if post.tags %}
              <div class="flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6">
                <span class="text-sm font-medium text-slate-500">🏷️ Tags:</span>
                {% for tag in post.tags %}
                  <a href="{{ tag.link }}" class="rspku-chip text-slate-700 transition hover:bg-hospital-100 hover:text-hospital-700">
                    {{ tag.name }}
                  </a>
                {% endfor %}
              </div>
            {% endif %}

            {% include 'partials/share-actions.twig' with {
              title: post.title,
              url: post.link
            } only %}

            {# Author bio card #}
            {% if post.author %}
              <div class="mt-10 rounded-lg border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-8">
                <p class="text-sm font-semibold uppercase tracking-wider text-hospital-700">Tentang Penulis</p>
                <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-start">
                  {% if post.author.avatar %}
                    <img src="{{ post.author.avatar }}" alt="{{ post.author.name }}" class="h-24 w-24 rounded-lg object-cover">
                  {% else %}
                    <div class="grid h-24 w-24 shrink-0 place-items-center rounded-lg bg-hospital-100 text-3xl font-bold text-hospital-700">
                      {{ post.author.name|slice(0, 1)|upper }}
                    </div>
                  {% endif %}
                  <div class="flex-1 space-y-3">
                    <div>
                      <h3 class="text-xl font-semibold text-slate-950">{{ post.author.name }}</h3>
                      {% if post.author.title %}
                        <p class="mt-1 text-sm font-medium text-hospital-700">{{ post.author.title }}</p>
                      {% endif %}
                    </div>
                    {% if post.author.description %}
                      <p class="text-sm leading-relaxed text-slate-600">{{ post.author.description }}</p>
                    {% endif %}
                    {% if post.author.url %}
                      <a href="{{ post.author.url }}" class="inline-flex items-center gap-2 text-sm font-medium text-hospital-700 transition hover:text-hospital-800">
                        Lihat profil lengkap
                        {{ icon('arrow-right', { class: 'h-4 w-4' }) }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>

          <aside class="space-y-5 xl:sticky xl:top-28 xl:self-start">
            <section class="rspku-side-panel">
              <p class="text-sm font-medium text-slate-500">Info artikel</p>
              <div class="mt-6 space-y-4 text-sm leading-normal text-slate-600">
                <div>
                  <p class="font-semibold text-slate-950">Tanggal terbit</p>
                  <p class="mt-1">{{ post.date('j M Y') }}</p>
                </div>
                <div>
                  <p class="font-semibold text-slate-950">Penulis</p>
                  <p class="mt-1">{{ post.author.name|default('Tim RS PKU') }}</p>
                </div>
                {% if primary_category %}
                  <div>
                    <p class="font-semibold text-slate-950">Kategori</p>
                    <a href="{{ primary_category.url }}" class="mt-1 inline-flex text-hospital-700 transition hover:text-hospital-800">{{ primary_category.name }}</a>
                  </div>
                {% endif %}
              </div>
            </section>
            {% include 'partials/article-sidebar-list.twig' with {
              title: 'Populer dibaca',
              eyebrow: 'Sidebar artikel',
              icon_name: 'newspaper',
              items: article_single.popular_articles
            } only %}
          </aside>
        </div>
      </div>
    </article>

    {% if article_single.related_articles %}
      <section class="rspku-section pt-0">
        <div class="rspku-container space-y-10">
          <div>
            <span class="rspku-eyebrow">Artikel terkait</span>
            <h2 class="mt-4 text-3xl font-semibold leading-tight text-slate-950 sm:text-4xl">Artikel terkait lainnya</h2>
          </div>

          <div class="grid gap-8 xl:grid-cols-3">
            {% for item in article_single.related_articles %}
              {% include 'components/content-card.twig' with {
                item: item|merge({
                  badge: 'Berita & Artikel',
                  show_link: false
                })
              } %}
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}
  {% endif %}
{% endblock %}

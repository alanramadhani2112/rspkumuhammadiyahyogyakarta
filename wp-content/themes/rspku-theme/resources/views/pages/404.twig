{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="rspku-section">
    <div class="rspku-container max-w-3xl text-center">
      <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">404</span>
      <h1 class="mt-4 text-4xl font-black leading-tight text-slate-950 sm:text-5xl">Halaman tidak ditemukan</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">Konten yang dicari tidak tersedia atau sudah dipindahkan.</p>
      <a href="{{ site.url }}" class="rspku-button rspku-button-primary mt-8">{{ icon('house', { class: 'h-4 w-4' }) }}<span>Kembali ke beranda</span></a>
    </div>
  </section>
{% endblock %}

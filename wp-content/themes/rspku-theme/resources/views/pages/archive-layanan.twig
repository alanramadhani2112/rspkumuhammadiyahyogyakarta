{% extends 'layouts/base.twig' %}

{% block content %}
  {% if service_archive is defined %}
    {% set featured = service_archive.featured %}
    {% set breadcrumb_items = [{ title: 'Home', url: site.url }] %}
    {% if service_archive.breadcrumb_parent %}
      {% set breadcrumb_items = breadcrumb_items|merge([service_archive.breadcrumb_parent]) %}
    {% endif %}
    {% set breadcrumb_items = breadcrumb_items|merge([{ title: service_archive.title, current: true }]) %}
    <section class="rspku-section pb-8">
      <div class="rspku-container space-y-8">
        {% include 'partials/breadcrumb.twig' with { items: breadcrumb_items } only %}

        <div class="grid gap-8 xl:grid-cols-[1fr_0.95fr] xl:items-end">
          <div class="space-y-6">
            <span class="rspku-eyebrow">{{ service_archive.eyebrow }}</span>
            <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl xl:text-[3.25rem]">{{ service_archive.title }}</h1>
            <p class="max-w-2xl text-base leading-relaxed text-slate-600">{{ service_archive.description }}</p>
            <div class="flex flex-wrap gap-3">
              <span class="rspku-chip">{{ service_archive.total }} layanan ditampilkan</span>
              <a href="{{ site.url }}/poliklinik/" class="rspku-chip">Lihat poliklinik</a>
            </div>
          </div>

          <div class="overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
            {% if featured and featured.image and featured.image.url %}
              <img src="{{ featured.image.url }}" alt="{{ featured.title }}" class="aspect-[16/10] w-full object-cover">
            {% else %}
              <div class="grid aspect-[16/10] place-items-center bg-[radial-gradient(circle_at_top_right,_rgba(159,212,91,0.18),_transparent_32%),linear-gradient(180deg,#f8fbf8_0%,#eef6f0_100%)] p-8 text-center">
                <div class="space-y-4">
                  <div class="mx-auto grid h-16 w-16 place-items-center rounded-lg border border-hospital-200 bg-white text-hospital-700">
                    {{ icon('stethoscope', { class: 'h-8 w-8' }) }}
                  </div>
                  <p class="text-lg font-semibold text-slate-700">Pilihan layanan medis RS PKU Muhammadiyah Yogyakarta</p>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        {% if service_archive.items %}
          <div class="rspku-divider"></div>

          <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
            {% for item in service_archive.items %}
              <article class="group flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white">
                <a href="{{ item.url }}" class="block overflow-hidden bg-slate-100">
                  {% if item.image and item.image.url %}
                    <img src="{{ item.image.url }}" alt="{{ item.title }}" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]">
                  {% else %}
                    <div class="grid aspect-[16/11] place-items-center bg-[linear-gradient(180deg,#f8fbf8_0%,#eef6f0_100%)] p-8 text-center">
                      <div class="space-y-4">
                        <div class="mx-auto grid h-14 w-14 place-items-center rounded-[1rem] border border-hospital-200 bg-white text-hospital-700">
                          {{ icon('hospital', { class: 'h-7 w-7' }) }}
                        </div>
                        <p class="text-sm font-medium text-hospital-700">Layanan medis</p>
                      </div>
                    </div>
                  {% endif %}
                </a>

                <div class="flex flex-1 flex-col gap-4 p-6">
                  <p class="text-sm font-medium text-hospital-700">{{ service_archive.eyebrow }}</p>
                  <h2 class="text-[1.25rem] font-semibold leading-7 text-slate-950">
                    <a href="{{ item.url }}" class="transition hover:text-hospital-700">{{ item.title }}</a>
                  </h2>
                  {% if item.excerpt %}
                    <p class="text-[15px] leading-7 text-slate-600">{{ item.excerpt }}</p>
                  {% endif %}
                  <div class="mt-auto pt-2">
                    <a href="{{ item.url }}" class="rspku-button rspku-button-secondary w-full">Lihat detail layanan</a>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {% include 'partials/pagination.twig' with {
          pagination: pagination,
          class: 'pt-2',
          label: 'Pagination layanan',
          total: service_archive.total|default(0),
          per_page: service_archive.per_page|default(10),
          current_page: service_archive.current_page|default(1),
          total_pages: service_archive.total_pages|default(1),
          show_single: true,
          item_label: 'layanan'
        } only %}
      </div>
    </section>
  {% endif %}
{% endblock %}

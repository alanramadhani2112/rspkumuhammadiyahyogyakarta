{% extends 'layouts/base.twig' %}

{% block content %}
  {% set hero_visual = home.rooms|first ?: home.services|first ?: home.articles|first %}
  {% set service_cards = home.services %}
  {% set first_feature = home.services|first ?: home.polyclinics|first %}
  {% set home_actions = [
    { title: 'Cari Dokter', text: 'Temukan dokter dari jadwal resmi.', url: site.url ~ '/dokter/', icon: 'search' },
    { title: 'Poliklinik', text: 'Telusuri klinik dan layanan rawat jalan.', url: site.url ~ '/poliklinik/', icon: 'stethoscope' },
    { title: 'Rawat Inap', text: 'Cek fasilitas kamar dan perawatan.', url: site.url ~ '/rawat-inap/', icon: 'building-2' },
    { title: 'Jadwal Dokter', text: 'Lihat praktik terbaru dan filter spesialisasi.', url: site.url ~ '/jadwal-dokter/', icon: 'calendar-days' }
  ] %}
  {% set home_cta_primary_url = rspku.home_cta_primary_url|default('/dokter/') %}
  {% set home_cta_primary_href = home_cta_primary_url starts with 'http' or home_cta_primary_url starts with 'tel:' or home_cta_primary_url starts with 'mailto:' ? home_cta_primary_url : site.url ~ home_cta_primary_url %}
  {% set home_cta_secondary_url = rspku.home_cta_secondary_url|default('tel:0274512321') %}
  {% set home_cta_secondary_href = home_cta_secondary_url starts with 'http' or home_cta_secondary_url starts with 'tel:' or home_cta_secondary_url starts with 'mailto:' ? home_cta_secondary_url : site.url ~ home_cta_secondary_url %}

  {# Hero Section - Green Gradient Only #}
  <section class="relative overflow-hidden bg-gradient-to-br from-hospital-100/40 via-hospital-50/30 to-white pb-12 pt-8">
    <div class="rspku-container">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        {# Hero Content #}
        <div class="space-y-8">
          <div class="inline-flex items-center gap-2 rounded-full bg-hospital-50 px-4 py-2 text-sm font-medium text-hospital-700">
            {{ icon('heart-pulse', { class: 'h-4 w-4' }) }}
            <span>{{ rspku.tagline }}</span>
          </div>
          
          <div class="space-y-6">
            <h1 class="text-4xl font-bold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">
              {{ rspku.hero_title|wp_kses_post }}
            </h1>
            <p class="max-w-xl text-lg leading-relaxed text-slate-600">{{ rspku.hero_description }}</p>
          </div>

          {# Primary CTAs #}
          <div class="flex flex-wrap gap-3">
            {% include 'components/button.twig' with {
              text: rspku.hero_cta_primary_text,
              url: rspku.hero_cta_primary_url starts with 'http' ? rspku.hero_cta_primary_url : site.url ~ rspku.hero_cta_primary_url,
              variant: 'primary',
              icon: 'search'
            } only %}
            {% include 'components/button.twig' with {
              text: rspku.hero_cta_secondary_text,
              url: rspku.hero_cta_secondary_url starts with 'http' ? rspku.hero_cta_secondary_url : site.url ~ rspku.hero_cta_secondary_url,
              variant: 'secondary',
              icon: 'stethoscope'
            } only %}
          </div>

          {# Key Metrics - From Settings #}
          <div class="grid gap-8 border-t border-slate-200 pt-8 sm:grid-cols-3">
            <div>
              <p class="text-3xl font-bold text-slate-950">{{ rspku.metric_1_value }}</p>
              <p class="mt-2 text-sm text-slate-600">{{ rspku.metric_1_label }}</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-slate-950">{{ rspku.metric_2_value }}</p>
              <p class="mt-2 text-sm text-slate-600">{{ rspku.metric_2_label }}</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-slate-950">{{ rspku.metric_3_value }}</p>
              <p class="mt-2 text-sm text-slate-600">{{ rspku.metric_3_label }}</p>
            </div>
          </div>
        </div>

        {# Hero Visual - Clean #}
        <div class="relative">
          <div class="overflow-hidden rounded-2xl bg-slate-100">
            {% if rspku.hero_image_id or rspku.hero_image_url %}
              {% include 'partials/responsive-image.twig' with {
                id: rspku.hero_image_id,
                url: rspku.hero_image_url,
                alt: rspku.site_name,
                class: 'aspect-[4/3] w-full object-cover',
                sizes: '(min-width: 1024px) 50vw, 100vw',
                width: 1200,
                height: 900,
                eager: true
              } only %}
            {% elseif hero_visual and hero_visual.image and hero_visual.image.url %}
              {% include 'partials/responsive-image.twig' with {
                id: hero_visual.image.id,
                url: hero_visual.image.url,
                alt: hero_visual.title|default(site.name),
                class: 'aspect-[4/3] w-full object-cover',
                sizes: '(min-width: 1024px) 50vw, 100vw',
                width: 1200,
                height: 900,
                eager: true
              } only %}
            {% else %}
              <div class="grid aspect-[4/3] place-items-center bg-hospital-50/30 p-8 text-center text-lg font-semibold text-slate-500">Visual layanan rumah sakit</div>
            {% endif %}
          </div>
          
          {# Emergency Contact - Simple Card #}
          <div class="absolute -bottom-4 left-6 right-6 rounded-xl bg-white p-4 shadow-md">
            <div class="flex items-center gap-4">
              <div class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-hospital-600 text-white">
                {{ icon('phone', { class: 'h-6 w-6' }) }}
              </div>
              <div class="flex-1">
                <p class="text-xs font-medium text-slate-500">IGD 24 Jam</p>
                <a href="tel:{{ rspku.phone_igd_link }}" class="text-lg font-bold text-slate-950 hover:text-hospital-700">{{ rspku.phone_igd }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {# Quick Actions - Reusable Component #}
  <section class="py-12">
    <div class="rspku-container">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {% for action in home_actions %}
          {% include 'components/action-card.twig' with { item: action } only %}
        {% endfor %}
      </div>
    </div>
  </section>

  {# Services Section - Reusable Cards with Links #}
  {% if service_cards %}
    <section class="bg-slate-50/50 py-16">
      <div class="rspku-container space-y-12">
        <div class="text-center">
          <span class="inline-block rounded-full bg-hospital-50 px-4 py-1 text-sm font-medium text-hospital-700">Layanan unggulan</span>
          <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-bold text-slate-950 sm:text-4xl">Layanan Kesehatan Andalan Kami</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">Berbagai layanan unggulan kami dirancang khusus untuk memberikan solusi kesehatan yang tepat, aman, nyaman, dan terjangkau.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {% for item in service_cards|slice(0, 6) %}
            {% include 'components/service-card.twig' with { item: item } only %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {# Feature Section #}
  {% if first_feature %}
    <section class="py-16">
      <div class="rspku-container">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="space-y-6">
            <span class="inline-block rounded-full bg-hospital-50 px-4 py-1 text-sm font-medium text-hospital-700">Layanan medis</span>
            <h2 class="text-3xl font-bold text-slate-950 sm:text-4xl">Pelayanan Profesional Berlandaskan Nilai Islami</h2>
            <p class="text-lg text-slate-600">Kami berkomitmen memberikan pelayanan kesehatan terbaik dengan alur informasi yang rapi, tampilan yang bersih, dan pengalaman pasien yang lebih mudah dipahami.</p>
            
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-hospital-100 text-hospital-700">
                  {{ icon('check', { class: 'h-4 w-4' }) }}
                </div>
                <div>
                  <p class="font-semibold text-slate-950">Dokter Berpengalaman</p>
                  <p class="text-sm text-slate-600">Tim medis profesional dengan spesialisasi lengkap</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-hospital-100 text-hospital-700">
                  {{ icon('check', { class: 'h-4 w-4' }) }}
                </div>
                <div>
                  <p class="font-semibold text-slate-950">Fasilitas Modern</p>
                  <p class="text-sm text-slate-600">Peralatan medis canggih dan ruangan nyaman</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-hospital-100 text-hospital-700">
                  {{ icon('check', { class: 'h-4 w-4' }) }}
                </div>
                <div>
                  <p class="font-semibold text-slate-950">Pelayanan 24/7</p>
                  <p class="text-sm text-slate-600">IGD dan layanan darurat siap setiap saat</p>
                </div>
              </div>
            </div>

            {% include 'components/button.twig' with {
              text: 'Lihat semua layanan',
              url: site.url ~ '/layanan/',
              variant: 'primary',
              icon: 'arrow-right'
            } only %}
          </div>
          
          <div class="overflow-hidden rounded-2xl bg-slate-100">
            {% if rspku.home_feature_image_url %}
              <img src="{{ rspku.home_feature_image_url }}" alt="Pelayanan profesional RS PKU" loading="lazy" width="1200" height="900" class="aspect-[4/3] w-full object-cover">
            {% elseif first_feature.image and first_feature.image.url %}
              <img src="{{ first_feature.image.url }}" alt="{{ first_feature.title }}" loading="lazy" width="1200" height="900" class="aspect-[4/3] w-full object-cover">
            {% else %}
              <div class="grid aspect-[4/3] place-items-center bg-hospital-50/30 p-8 text-center text-lg font-semibold text-slate-500">{{ first_feature.title }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# Doctors Section #}
  {% if home.doctors %}
    <section class="bg-slate-50/50 py-16">
      <div class="rspku-container space-y-12">
        <div class="text-center">
          <span class="inline-block rounded-full bg-hospital-50 px-4 py-1 text-sm font-medium text-hospital-700">Dokter pilihan</span>
          <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-bold text-slate-950 sm:text-4xl">Dokter Berpengalaman dan Terpercaya</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">Temukan dokter spesialis sesuai kebutuhan Anda dengan jadwal praktik yang jelas dan mudah diakses.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {% for doctor in home.doctors|slice(0, 6) %}
            {% include 'partials/doctor-card.twig' with {
              doctor: doctor,
              appointment_cta_text: rspku.doctor_appointment_cta_text|default('Buat janji'),
              appointment_fallback_url: rspku.doctor_appointment_fallback_url|default('/kontak/')
            } %}
          {% endfor %}
        </div>
        <div class="text-center">
          {% include 'components/button.twig' with {
            text: 'Lihat semua dokter',
            url: site.url ~ '/dokter/',
            variant: 'secondary',
            icon: 'arrow-right'
          } only %}
        </div>
      </div>
    </section>
  {% endif %}

  {# Reviews Section - Overflow Carousel (controlled by feature toggle) #}
  {% if home.reviews and (rspku.feature_reviews_carousel is not defined or rspku.feature_reviews_carousel) %}
    <section class="relative overflow-hidden py-16">
      <div class="absolute inset-0 bg-gradient-to-br from-yellow-50 via-orange-50/30 to-white"></div>
      
      <div class="rspku-container relative space-y-10">
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="inline-block rounded-full bg-yellow-100 px-4 py-1 text-sm font-medium text-yellow-800">Ulasan pasien</span>
            <h2 class="mt-4 text-3xl font-bold text-slate-950 sm:text-4xl">Apa Kata Pasien Kami</h2>
          </div>
          
          {% if home.review_summary %}
            <div class="inline-flex items-center gap-4 rounded-xl border border-yellow-200 bg-white px-5 py-3">
              <div class="text-3xl font-bold text-yellow-600">{{ home.review_summary.rating|default('4.8') }}</div>
              <div class="flex gap-0.5">
                {% for _ in 1..5 %}
                  <svg class="h-4 w-4 fill-yellow-500" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                {% endfor %}
              </div>
              <a href="{{ home.review_summary.place_url }}" target="_blank" rel="noopener" class="text-xs font-medium text-slate-500 hover:text-yellow-700">
                {{ home.review_summary.reviews_label|default('1,234 ulasan') }}
                {{ icon('external-link', { class: 'inline h-3 w-3' }) }}
              </a>
            </div>
          {% endif %}
        </div>

        {# Reviews Carousel - 10 cards, 4 visible, overflow out of container #}
        <div x-data="reviewsCarousel" class="relative lg:-mr-8 xl:-mr-[calc((100vw-76rem)/2)]">
          <div
            x-ref="track"
            @pointerdown="start($event)"
            @pointermove="move($event)"
            @pointerup="end"
            @pointerleave="end"
            class="flex gap-5 overflow-x-auto pb-4 pr-8 scrollbar-hide"
            :class="dragging ? 'cursor-grabbing' : 'cursor-grab'"
            style="scroll-snap-type: x mandatory; scroll-padding-left: 0;"
          >
            {% for review in home.reviews|slice(0, 10) %}
              <div class="w-[280px] flex-none sm:w-[300px] lg:w-[calc(25%-1rem)]" style="scroll-snap-align: start;">
                <div class="h-full rounded-xl border border-yellow-200 bg-white p-5 transition hover:border-yellow-400 hover:shadow-sm">
                  {% include 'partials/review-card.twig' with { review: review } %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# Articles Section #}
  {% if home.articles %}
    <section class="bg-slate-50/50 py-16">
      <div class="rspku-container space-y-12">
        <div class="flex items-end justify-between">
          <div>
            <span class="inline-block rounded-full bg-hospital-50 px-4 py-1 text-sm font-medium text-hospital-700">Berita & Informasi</span>
            <h2 class="mt-4 text-3xl font-bold text-slate-950 sm:text-4xl">Berita & Artikel Terkini</h2>
          </div>
          <a href="{{ site.url }}/berita-artikel/" class="hidden items-center gap-2 text-sm font-medium text-hospital-700 hover:text-hospital-800 lg:flex">
            <span>Lihat semua artikel</span>
            {{ icon('arrow-right', { class: 'h-4 w-4' }) }}
          </a>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {% for item in home.articles|slice(0, 3) %}
            {% include 'components/content-card.twig' with { item: item|merge({ badge: 'Berita', show_link: false }) } %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {# CTA Section - Prominent Button #}
  <section class="py-16">
    <div class="rspku-container">
      <div class="overflow-hidden rounded-2xl bg-gradient-to-br from-hospital-600 to-hospital-700 p-12 lg:p-16">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="space-y-6 text-white">
            <span class="inline-block rounded-full bg-white/20 px-4 py-1 text-sm font-medium">Mudah dan cepat</span>
            <h2 class="text-3xl font-bold sm:text-4xl">Jaga Kesehatan Anda Bersama Kami</h2>
            <p class="max-w-2xl text-lg text-white/90">Kesehatan Anda prioritas kami. Buat janji dengan dokter spesialis pilihan Anda sekarang juga.</p>
            
            <div class="flex flex-wrap gap-3">
              {% include 'components/button.twig' with {
                text: rspku.home_cta_primary_text|default('Buat janji sekarang'),
                url: home_cta_primary_href,
                variant: 'white',
                icon: 'calendar-check',
                size: 'lg'
              } only %}
              {% include 'components/button.twig' with {
                text: rspku.home_cta_secondary_text|default('Hubungi IGD'),
                url: home_cta_secondary_href,
                variant: 'ghost',
                icon: 'phone'
              } only %}
            </div>
          </div>

          <div class="hidden lg:block">
            <div class="overflow-hidden rounded-xl bg-white/10 p-1">
              {% if rspku.home_cta_image_url %}
                <img src="{{ rspku.home_cta_image_url }}" alt="{{ rspku.site_name }}" loading="lazy" width="600" height="600" class="aspect-square w-56 rounded-lg object-cover">
              {% elseif hero_visual and hero_visual.image and hero_visual.image.url %}
                <img src="{{ hero_visual.image.url }}" alt="{{ hero_visual.title|default(site.name) }}" loading="lazy" width="600" height="600" class="aspect-square w-56 rounded-lg object-cover">
              {% else %}
                <div class="grid aspect-square w-56 place-items-center rounded-lg bg-white/20">
                  {{ icon('hospital', { class: 'h-16 w-16 text-white' }) }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}

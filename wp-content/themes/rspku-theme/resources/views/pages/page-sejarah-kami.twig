{% extends 'layouts/base.twig' %}

{% block content %}
  {% if history_page is defined %}
    <section class="rspku-section pb-8">
      <div class="rspku-container space-y-12">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Sejarah Kami', current: true }
          ]
        } only %}

        <div class="grid gap-10 xl:grid-cols-[0.9fr_1.1fr] xl:items-start">
          <div class="space-y-6">
            <span class="rspku-eyebrow">{{ history_page.eyebrow }}</span>
            <h1 class="max-w-3xl text-[2.25rem] font-semibold leading-[1.08] text-slate-950 sm:text-[2.75rem] xl:text-[3.25rem]">{{ history_page.title }}</h1>
            <p class="max-w-2xl text-base leading-8 text-slate-600">{{ history_page.description }}</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {% for item in history_page.milestones %}
              <article class="border border-slate-200 bg-white p-6">
                <p class="text-sm font-semibold text-hospital-700">{{ item.label }}</p>
                <h2 class="mt-4 text-[1.45rem] font-semibold leading-tight text-slate-950">{{ item.title }}</h2>
                <p class="mt-4 text-[15px] leading-7 text-slate-600">{{ item.body }}</p>
              </article>
            {% endfor %}
          </div>
        </div>

        <div class="rspku-divider"></div>

        <div class="grid gap-6 lg:grid-cols-3">
          {% for item in history_page.principles %}
            <article class="border border-slate-200 bg-white p-6">
              <p class="text-sm font-medium text-hospital-700">Prinsip utama</p>
              <h2 class="mt-3 text-[1.45rem] font-semibold leading-tight text-slate-950">{{ item.title }}</h2>
              {% if item.body %}
                <p class="mt-4 text-[15px] leading-7 text-slate-600">{{ item.body }}</p>
              {% endif %}
              {% if item.items %}
                <div class="mt-4 space-y-3 text-[15px] leading-7 text-slate-600">
                  {% for line in item.items %}
                    <p>{{ line }}</p>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div class="space-y-4">
            <span class="rspku-eyebrow">Nilai ALMAUN</span>
            <h2 class="text-[2.15rem] font-semibold leading-tight text-slate-950">Nilai yang menjaga arah pelayanan</h2>
            <p class="text-[15px] leading-8 text-slate-600">Amanah, lengkap, mutu, antusias, universal, dan nyaman menjadi landasan operasional rumah sakit dalam melayani pasien, keluarga, dan masyarakat luas.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {% for value in history_page.values %}
              <article class="border border-slate-200 bg-[#f8fbf8] p-5 text-[15px] leading-7 text-slate-700">
                {{ value }}
              </article>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

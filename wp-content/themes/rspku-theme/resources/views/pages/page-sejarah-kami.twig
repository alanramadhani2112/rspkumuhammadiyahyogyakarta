{% extends 'layouts/base.twig' %}

{% block content %}
  {% if history_page is defined %}
    {% set history_gallery = history_page.gallery|default([]) %}
    {% set history_gallery_slots = {} %}
    {% for gallery_item in history_gallery %}
      {% set history_gallery_slots = history_gallery_slots|merge({ (gallery_item.key): gallery_item }) %}
    {% endfor %}
    {% set history_hero = history_gallery_slots.history_hero|default(null) %}
    {% set history_pioneers = history_gallery_slots.history_pioneers|default(null) %}
    {% set history_child_service = history_gallery_slots.history_child_service|default(null) %}
    {% set history_first_stone = history_gallery_slots.history_first_stone|default(null) %}
    {% set history_modernization = history_gallery_slots.history_modernization|default(null) %}

    {# Hero Section - Clean, Medical Look #}
    <section class="rspku-section pb-8">
      <div class="rspku-container">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Sejarah Kami', current: true }
          ]
        } only %}

        <div class="mt-6 {% if history_hero %}grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center{% else %}max-w-4xl{% endif %}">
          <div class="space-y-5">
            <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_page.eyebrow }}</span>
            <h1 class="text-3xl font-bold leading-tight text-slate-950 sm:text-4xl lg:text-5xl">{{ history_page.title }}</h1>
            <p class="max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">{{ history_page.description }}</p>
          </div>

          {% if history_hero %}
            <figure class="overflow-hidden rounded-md border border-slate-200 bg-slate-100">
              {% include 'partials/responsive-image.twig' with {
                id: history_hero.image_id,
                url: history_hero.image_url,
                alt: history_hero.alt,
                class: 'aspect-[4/3] w-full object-cover',
                sizes: '(min-width: 1024px) 42vw, 100vw',
                width: 1200,
                height: 900,
                default_size: 'rspku-hero',
                eager: true
              } only %}
              <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-600">
                <span class="block text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_hero.year }}</span>
                <span class="mt-1 block font-semibold text-slate-950">{{ history_hero.title }}</span>
                <span class="mt-1 block">{{ history_hero.caption }}</span>
              </figcaption>
            </figure>
          {% endif %}
        </div>

        {# Stats Row #}
        {% if history_page.stats %}
          <div class="mt-10 grid grid-cols-2 gap-4 border-y border-slate-200 py-8 lg:grid-cols-4">
            {% for stat in history_page.stats %}
              <div>
                <p class="text-3xl font-bold text-hospital-700 sm:text-4xl">{{ stat.value }}</p>
                <p class="mt-1 text-sm text-slate-600">{{ stat.label }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>

    {# Milestone Timeline #}
    {% if history_page.milestones %}
      <section class="py-12">
        <div class="rspku-container">
          <div class="mx-auto max-w-3xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wide text-hospital-700">Timeline</span>
            <h2 class="mt-2 text-2xl font-bold text-slate-950 sm:text-3xl">Milestone Perjalanan Kami</h2>
            <p class="mx-auto mt-3 max-w-2xl text-sm text-slate-600">Dari klinik sederhana menjadi rumah sakit islami yang melayani lebih dari satu abad</p>
          </div>

          <div class="relative mt-12">
            <div class="relative">
              {# Vertical line - desktop only, stops before "Hari Ini" marker #}
              <div class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-hospital-200 lg:block" aria-hidden="true"></div>
              {# Vertical line - mobile (left side) #}
              <div class="absolute left-5 top-0 h-full w-px bg-hospital-200 lg:hidden" aria-hidden="true"></div>

              <div class="space-y-8 lg:space-y-0">
                {% for item in history_page.milestones %}
                  {% set is_even = loop.index is even %}
                  <div class="relative lg:grid lg:grid-cols-2 lg:gap-8 {% if not loop.last %}lg:pb-12{% endif %}">

                    {# Timeline dot - centered on desktop, left on mobile #}
                    <div class="absolute left-5 top-5 grid h-10 w-10 -translate-x-1/2 place-items-center rounded-full border-2 border-hospital-200 bg-white text-hospital-700 lg:left-1/2 lg:top-0 lg:-translate-x-1/2">
                      {{ icon(item.icon|default('circle'), { class: 'h-4 w-4' }) }}
                    </div>

                    {# Card - alternates left/right on desktop #}
                    <div class="ml-14 lg:ml-0 {% if is_even %}lg:col-start-2 lg:pl-12{% else %}lg:col-start-1 lg:pr-12 lg:text-right{% endif %}">
                      <div class="rounded-md border border-slate-200 bg-white p-6 transition hover:border-hospital-300">
                        <div class="flex items-center gap-3 {% if is_even %}lg:flex-row{% else %}lg:flex-row-reverse{% endif %}">
                          <span class="inline-block rounded-sm bg-hospital-600 px-3 py-1 text-sm font-bold tracking-tight text-white">{{ item.year }}</span>
                          <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ item.label }}</span>
                        </div>
                        <h3 class="mt-4 text-lg font-semibold leading-tight text-slate-950">{{ item.title }}</h3>
                        <p class="mt-3 text-sm leading-relaxed text-slate-600">{{ item.body }}</p>
                      </div>
                    </div>

                  </div>
                  {% if loop.index == 1 and history_pioneers %}
                    <figure class="relative ml-14 overflow-hidden rounded-md border border-slate-200 bg-slate-100 lg:mx-auto lg:mb-12 lg:max-w-3xl">
                      {% include 'partials/responsive-image.twig' with {
                        id: history_pioneers.image_id,
                        url: history_pioneers.image_url,
                        alt: history_pioneers.alt,
                        class: 'aspect-[16/9] w-full object-cover',
                        sizes: '(min-width: 1024px) 768px, 100vw',
                        width: 1200,
                        height: 675,
                        default_size: 'rspku-hero'
                      } only %}
                      <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-600">
                        <span class="block text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_pioneers.year }}</span>
                        <span class="mt-1 block font-semibold text-slate-950">{{ history_pioneers.title }}</span>
                        <span class="mt-1 block">{{ history_pioneers.caption }}</span>
                      </figcaption>
                    </figure>
                  {% endif %}
                  {% if loop.index == 2 and history_child_service %}
                    <figure class="relative ml-14 overflow-hidden rounded-md border border-slate-200 bg-slate-100 lg:mx-auto lg:mb-12 lg:max-w-3xl">
                      {% include 'partials/responsive-image.twig' with {
                        id: history_child_service.image_id,
                        url: history_child_service.image_url,
                        alt: history_child_service.alt,
                        class: 'aspect-[16/9] w-full object-cover',
                        sizes: '(min-width: 1024px) 768px, 100vw',
                        width: 1200,
                        height: 675,
                        default_size: 'rspku-hero'
                      } only %}
                      <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-600">
                        <span class="block text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_child_service.year }}</span>
                        <span class="mt-1 block font-semibold text-slate-950">{{ history_child_service.title }}</span>
                        <span class="mt-1 block">{{ history_child_service.caption }}</span>
                      </figcaption>
                    </figure>
                  {% endif %}
                  {% if loop.index == 3 and history_first_stone %}
                    <figure class="relative ml-14 overflow-hidden rounded-md border border-slate-200 bg-slate-100 lg:mx-auto lg:mb-12 lg:max-w-3xl">
                      {% include 'partials/responsive-image.twig' with {
                        id: history_first_stone.image_id,
                        url: history_first_stone.image_url,
                        alt: history_first_stone.alt,
                        class: 'aspect-[16/9] w-full object-cover',
                        sizes: '(min-width: 1024px) 768px, 100vw',
                        width: 1200,
                        height: 675,
                        default_size: 'rspku-hero'
                      } only %}
                      <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-600">
                        <span class="block text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_first_stone.year }}</span>
                        <span class="mt-1 block font-semibold text-slate-950">{{ history_first_stone.title }}</span>
                        <span class="mt-1 block">{{ history_first_stone.caption }}</span>
                      </figcaption>
                    </figure>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            {# Present day marker - outside timeline line #}
            <div class="relative mt-8 flex items-center gap-4 lg:mt-0 lg:justify-center lg:gap-0">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-hospital-600 text-white lg:absolute lg:left-1/2 lg:-translate-x-1/2">
                {{ icon('map-pin', { class: 'h-4 w-4' }) }}
              </div>
              <div class="rounded-sm bg-hospital-50 px-4 py-2 text-sm font-semibold text-hospital-700 lg:mt-14">Hari Ini</div>
            </div>
            {% if history_modernization %}
              <figure class="mt-8 overflow-hidden rounded-md border border-slate-200 bg-slate-100 lg:mx-auto lg:max-w-3xl">
                {% include 'partials/responsive-image.twig' with {
                  id: history_modernization.image_id,
                  url: history_modernization.image_url,
                  alt: history_modernization.alt,
                  class: 'aspect-[16/9] w-full object-cover',
                  sizes: '(min-width: 1024px) 768px, 100vw',
                  width: 1200,
                  height: 675,
                  default_size: 'rspku-hero'
                } only %}
                <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-600">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-hospital-700">{{ history_modernization.year }}</span>
                  <span class="mt-1 block font-semibold text-slate-950">{{ history_modernization.title }}</span>
                  <span class="mt-1 block">{{ history_modernization.caption }}</span>
                </figcaption>
              </figure>
            {% endif %}
          </div>
        </div>
      </section>
    {% endif %}

    {# Principles - Falsafah, Visi, Misi #}
    {% if history_page.principles %}
      <section class="bg-slate-50/50 py-16">
        <div class="rspku-container">
          <div class="mx-auto max-w-3xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wide text-hospital-700">Fondasi</span>
            <h2 class="mt-2 text-2xl font-bold text-slate-950 sm:text-3xl">Falsafah, Visi, dan Misi</h2>
            <p class="mx-auto mt-3 max-w-2xl text-sm text-slate-600">Landasan yang menjaga arah pelayanan kami selama satu abad lebih</p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {% for item in history_page.principles %}
              <article class="rounded-md border border-slate-200 bg-white p-6 transition hover:border-hospital-300">
                <div class="grid h-11 w-11 place-items-center rounded-sm bg-hospital-50 text-hospital-700">
                  {{ icon(item.icon|default('circle'), { class: 'h-5 w-5' }) }}
                </div>
                <h3 class="mt-5 text-lg font-semibold text-slate-950">{{ item.title }}</h3>
                {% if item.body %}
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{{ item.body }}</p>
                {% endif %}
                {% if item.items %}
                  <ol class="mt-4 space-y-3 text-sm leading-relaxed text-slate-600">
                    {% for line in item.items %}
                      <li class="flex gap-3">
                        <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-hospital-50 text-xs font-semibold text-hospital-700">{{ loop.index }}</span>
                        <span>{{ line }}</span>
                      </li>
                    {% endfor %}
                  </ol>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {# Values - ALMAUN #}
    {% if history_page.values %}
      <section class="py-16">
        <div class="rspku-container">
          <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr] lg:items-start">
            <div class="lg:sticky lg:top-28">
              <span class="text-xs font-semibold uppercase tracking-wide text-hospital-700">Nilai ALMAUN</span>
              <h2 class="mt-2 text-2xl font-bold leading-tight text-slate-950 sm:text-3xl">Nilai yang menjaga arah pelayanan</h2>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">Enam nilai inti yang menjadi landasan operasional rumah sakit dalam melayani pasien, keluarga, dan masyarakat luas dengan spirit dakwah Muhammadiyah.</p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              {% for value in history_page.values %}
                <article class="flex items-start gap-4 rounded-md border border-slate-200 bg-white p-5 transition hover:border-hospital-300">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-sm bg-hospital-600 text-xl font-bold text-white">{{ value.letter }}</div>
                  <div>
                    <h3 class="text-base font-semibold text-slate-950">{{ value.name }}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-slate-600">{{ value.desc }}</p>
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {# CTA #}
    <section class="border-t border-slate-200 bg-slate-50/50 py-14">
      <div class="rspku-container">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-2xl font-bold text-slate-950 sm:text-3xl">Menjadi bagian dari perjalanan kami</h2>
          <p class="mx-auto mt-3 max-w-xl text-sm text-slate-600">Kami siap melayani Anda dan keluarga dengan standar layanan kesehatan islami yang telah teruji lebih dari 100 tahun.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            {% include 'components/button.twig' with {
              text: 'Cari Dokter',
              url: site.url ~ '/dokter/',
              variant: 'primary',
              icon: 'search'
            } only %}
            {% include 'components/button.twig' with {
              text: 'Hubungi Kami',
              url: site.url ~ '/kontak/',
              variant: 'secondary',
              icon: 'phone'
            } only %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

{% extends 'layouts/base.twig' %}

{% block content %}
  {% if management_single %}
    <section class="rspku-section pb-10">
      <div class="rspku-container space-y-10">
        {% include 'partials/breadcrumb.twig' with {
          items: [
            { title: 'Home', url: site.url },
            { title: 'Manajemen RS', url: site.url ~ '/manajemen-rs/' },
            { title: management_single.title, current: true }
          ]
        } only %}

        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1fr)] lg:items-start">
          <div class="overflow-hidden rounded-md border border-slate-200 bg-slate-100">
            {% if management_single.photo.url %}
              <img src="{{ management_single.photo.url }}" alt="{{ management_single.photo.alt|default(management_single.name) }}" class="aspect-[4/5] h-full w-full object-cover">
            {% else %}
              <div class="grid aspect-[4/5] place-items-center bg-[radial-gradient(circle_at_top_right,_rgba(0,158,230,0.16),_transparent_32%),linear-gradient(180deg,#f8fbff_0%,#eaf6ff_100%)] p-8 text-center">
                <div class="space-y-4">
                  <div class="mx-auto grid h-16 w-16 place-items-center rounded-sm border border-hospital-200 bg-white text-hospital-700">
                    {{ icon('building-2', { class: 'h-8 w-8' }) }}
                  </div>
                  <p class="text-sm font-medium text-hospital-700">Manajemen RS</p>
                </div>
              </div>
            {% endif %}
          </div>

          <div class="space-y-8">
            <header class="space-y-5">
              <span class="inline-block rounded-sm bg-hospital-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-hospital-700">Profil Manajemen</span>
              <div class="space-y-3">
                <h1 class="text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl xl:text-[3.35rem]">{{ management_single.name|default(management_single.title) }}</h1>
                {% if management_single.position %}
                  <p class="text-xl font-semibold leading-relaxed text-hospital-700">{{ management_single.position }}</p>
                {% endif %}
              </div>
              {% if management_single.excerpt %}
                <p class="max-w-3xl text-lg leading-relaxed text-slate-600">{{ management_single.excerpt }}</p>
              {% endif %}
            </header>

            {% if management_single.content %}
              <div class="rspku-prose max-w-none">
                {{ management_single.content }}
              </div>
            {% endif %}

            <div class="flex flex-wrap gap-3">
              <a href="{{ site.url }}/manajemen-rs/" class="inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700">Lihat struktur manajemen</a>
              <a href="{{ site.url }}/kontak/" class="inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700">Hubungi rumah sakit</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% else %}
    <section class="rspku-section">
      <div class="rspku-container">
        <div class="rounded-md border border-slate-200 bg-white p-8 text-center">
          <p class="text-sm font-semibold uppercase tracking-wide text-hospital-700">Profil tidak ditemukan</p>
          <h1 class="mt-3 text-3xl font-semibold text-slate-950">Profil manajemen belum tersedia.</h1>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600">Silakan kembali ke halaman Manajemen RS untuk melihat daftar pimpinan dan jajaran manajemen yang tersedia.</p>
          <a href="{{ site.url }}/manajemen-rs/" class="mt-6 inline-flex items-center gap-2 rounded-sm border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-hospital-300 hover:text-hospital-700">Kembali ke Manajemen RS</a>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

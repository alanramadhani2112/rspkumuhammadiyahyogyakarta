<!doctype html>
<html {{ function('language_attributes') }}>
<head>
  <meta charset="{{ site.charset|default('UTF-8') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ function('wp_head') }}
</head>
<body class="min-h-screen overflow-x-hidden text-slate-900 antialiased">
{{ function('wp_body_open') }}

{% set header_cta_url = rspku.header_cta_url|default('/dokter/') %}
{% set header_cta_href = header_cta_url starts with 'http' or header_cta_url starts with 'tel:' or header_cta_url starts with 'mailto:' ? header_cta_url : site.url ~ header_cta_url %}
{% set language_id_label = rspku.language_switcher_label_id|default('Bahasa Indonesia') %}
{% set language_en_label = rspku.language_switcher_label_en|default('English') %}

{% set fallback_primary = [
  { title: 'Beranda', link: site.url },
  { title: 'Layanan', link: site.url ~ '/layanan/' },
  { title: 'Fasilitas', link: site.url ~ '/fasilitas-rawat-inap/' },
  { title: 'Pusat informasi', link: site.url ~ '/berita-artikel/' },
  { title: 'Karir', link: site.url ~ '/karir/' },
  { title: 'Kontak', link: site.url ~ '/kontak/' }
] %}
{% set primary_items = menus.primary and menus.primary.items ? menus.primary.items : fallback_primary %}
{% set layanan_children = [
  { title: 'Semua layanan medis', link: site.url ~ '/layanan/' },
  { title: 'Layanan unggulan', link: site.url ~ '/layanan-medis/layanan-unggulan/' },
  { title: 'Layanan penunjang', link: site.url ~ '/layanan-medis/layanan-penunjang/' },
  { title: 'Poliklinik', link: site.url ~ '/poliklinik/' }
] %}
{% set fasilitas_children = [
  { title: 'Fasilitas rawat inap', link: site.url ~ '/fasilitas-rawat-inap/' },
  { title: 'Manajemen RS', link: site.url ~ '/manajemen-rs/' },
  { title: 'Kontak rumah sakit', link: site.url ~ '/kontak/' }
] %}
{% set info_children = [
  { title: 'Berita dan artikel', link: site.url ~ '/berita-artikel/' },
  { title: 'E-Jurnal', link: site.url ~ '/e-jurnal/' },
  { title: 'Legalitas', link: site.url ~ '/legalitas/' },
  { title: 'Sejarah', link: site.url ~ '/sejarah-kami/' }
] %}

<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:inline-flex focus:items-center focus:gap-2 focus:rounded-md focus:border-2 focus:border-hospital-600 focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-hospital-700 focus:shadow-lg focus:outline-none" href="#main">
  {{ icon('arrow-right', { class: 'h-4 w-4' }) }}
  <span>Lewati ke konten utama</span>
</a>

<header class="{{ rspku.header_sticky is not defined or rspku.header_sticky ? 'sticky top-0' : 'relative' }} z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-xl" x-data="siteNavigation" @keydown.escape.window="close">
  {# Top Bar - Compact Info #}
  {% if rspku.header_topbar_enabled is not defined or rspku.header_topbar_enabled %}
  <div class="border-b border-slate-200 bg-[#f4f5f2]">
    <div class="rspku-container flex items-center justify-between gap-3 py-2 text-sm text-slate-600 sm:gap-4">
      <div class="flex min-w-0 items-center gap-2 sm:gap-4">
        <a href="{{ site.url }}/kontak/" class="hidden min-w-0 flex-1 items-center gap-2 whitespace-nowrap font-medium transition hover:text-hospital-700 lg:inline-flex">
          {{ icon('map-pin', { class: 'h-3.5 w-3.5 shrink-0 text-hospital-600' }) }}
          <span>Jl. KH. Ahmad Dahlan No.20, Yogyakarta</span>
        </a>
        <div class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap font-medium sm:gap-2">
          {{ icon('phone', { class: 'h-3.5 w-3.5 shrink-0 text-hospital-600' }) }}
          <span class="hidden sm:inline">Call Center:</span>
          <a href="tel:{{ rspku.phone_igd_link }}" class="font-semibold transition hover:text-hospital-700" aria-label="Call Center {{ rspku.phone_igd }}">{{ rspku.phone_igd }}</a>
        </div>
      </div>
      <div class="flex min-w-0 shrink-0 items-center gap-2 sm:gap-4">
        {% if rspku.feature_gtranslate %}
        <div class="gtranslate_wrapper sr-only" aria-hidden="true">{{ function('do_shortcode', '[gtranslate]') }}</div>
        {# Language Switcher - Clean Flags Only #}
        <div class="flex items-center gap-1.5" data-rspku-language-switcher>
          <button type="button" data-rspku-lang="id" onclick="window.rspkuSwitchLanguage('id'); return false;" class="inline-block h-5 w-5 cursor-pointer overflow-hidden rounded-full border border-slate-200 transition hover:scale-110 hover:border-slate-400" title="{{ language_id_label }}" aria-label="{{ language_id_label }}">
            <img src="https://cdn.gtranslate.net/flags/svg/id.svg" alt="{{ language_id_label }}" class="h-full w-full object-cover">
          </button>
          <button type="button" data-rspku-lang="en" onclick="window.rspkuSwitchLanguage('en'); return false;" class="inline-block h-5 w-5 cursor-pointer overflow-hidden rounded-full border border-slate-200 transition hover:scale-110 hover:border-slate-400" title="{{ language_en_label }}" aria-label="{{ language_en_label }}">
            <img src="https://cdn.gtranslate.net/flags/svg/en.svg" alt="{{ language_en_label }}" class="h-full w-full object-cover">
          </button>
        </div>
        <script>
          window.rspkuSwitchLanguage = window.rspkuSwitchLanguage || function(language) {
            if (!window.gt_translate_script && typeof window.googleTranslateElementInit2 === 'function') {
              window.gt_translate_script = document.createElement('script');
              window.gt_translate_script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit2';
              document.body.appendChild(window.gt_translate_script);
            }

            if (typeof window.doGTranslate === 'function') {
              window.doGTranslate('id|' + language);
              return;
            }

            var select = document.querySelector('.gtranslate_wrapper select');

            if (select) {
              select.value = 'id|' + language;
              select.dispatchEvent(new Event('change', { bubbles: true }));
            }
          };
        </script>
        <noscript>
          <a href="https://translate.google.com/translate?sl=id&tl=id&u={{ site.url|url_encode }}" class="inline-block h-5 w-5 overflow-hidden rounded-full border border-slate-200" title="{{ language_id_label }}" aria-label="{{ language_id_label }}">
            <img src="https://cdn.gtranslate.net/flags/svg/id.svg" alt="{{ language_id_label }}" class="h-full w-full object-cover">
          </a>
          <a href="https://translate.google.com/translate?sl=id&tl=en&u={{ site.url|url_encode }}" class="inline-block h-5 w-5 overflow-hidden rounded-full border border-slate-200" title="{{ language_en_label }}" aria-label="{{ language_en_label }}">
            <img src="https://cdn.gtranslate.net/flags/svg/en.svg" alt="{{ language_en_label }}" class="h-full w-full object-cover">
          </a>
        </noscript>
        {% endif %}
        <a href="tel:{{ rspku.phone_igd_link }}" class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-red-600 px-2 py-1 text-xs font-bold leading-none text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-[#f4f5f2] sm:px-2.5" title="IGD 24 Jam Ext. 118" aria-label="IGD 24 Jam {{ rspku.phone_igd }}, Ext. 118">
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="#ffffff" stroke="none" aria-hidden="true" focusable="false">
            <path d="M10 2.25 1.8 17h16.4L10 2.25Zm0 4.6c.46 0 .82.36.82.82v4.72a.82.82 0 0 1-1.64 0V7.67c0-.46.36-.82.82-.82Zm0 8.35a1.05 1.05 0 1 1 0-2.1 1.05 1.05 0 0 1 0 2.1Z" fill="#ffffff" stroke="none" />
          </svg>
          <span class="whitespace-nowrap">IGD 24 Jam</span>
        </a>
      </div>
    </div>
  </div>
  {% endif %}

  {# Main Navigation #}
  <div class="rspku-container flex min-h-[4.5rem] items-center justify-between gap-6">
    {# Logo #}
    <a href="{{ site.url }}" class="flex shrink-0 items-center gap-3 text-slate-950">
      {% if site_logo.url %}
        <img src="{{ site_logo.url }}" alt="{{ site_logo.alt|default(site.name) }}" class="h-12 w-auto object-contain sm:h-14">
      {% else %}
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-hospital-700 text-lg font-black text-white">PKU</span>
        <span class="max-w-[12rem] text-sm font-bold leading-tight">{{ site.name }}</span>
      {% endif %}
    </a>

    {# Desktop Nav - Simplified #}
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Menu utama">
      {% for item in primary_items %}
        {% set title_lower = item.title|lower %}
        {% set children = item.children is defined and item.children ? item.children : (
          title_lower == 'layanan' ? layanan_children :
          (title_lower == 'fasilitas' ? fasilitas_children :
          (title_lower starts with 'pusat informasi' ? info_children : []))
        ) %}
        {% set has_children = children is not empty %}
        <div class="relative flex items-center" {% if has_children %}@mouseenter="openPanel('desktop-{{ loop.index }}')" @mouseleave="scheduleClose()" @focusin="openPanel('desktop-{{ loop.index }}')" @focusout="scheduleClose()"{% endif %}>
          <a href="{{ item.link }}" class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 {{ item.current is defined and item.current ? 'bg-slate-100 text-slate-950' : '' }}" {% if has_children %}:class="isPanel('desktop-{{ loop.index }}') ? 'bg-slate-100 text-slate-950' : ''"{% endif %}>
            <span>{{ item.title }}</span>
            {% if has_children %}
              <span class="transition duration-200" :class="isPanel('desktop-{{ loop.index }}') ? 'rotate-180' : ''">
                {{ icon('chevron-down', { class: 'h-3.5 w-3.5 text-slate-400' }) }}
              </span>
            {% endif %}
          </a>
          {% if has_children %}
            <div class="absolute left-0 top-full z-20 hidden w-[18rem] pt-2 lg:block" x-cloak x-show="isPanel('desktop-{{ loop.index }}')" x-transition.opacity.scale.origin.top.left.90 @mouseenter="cancelClose()" @mouseleave="scheduleClose()">
              <div class="overflow-hidden rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg">
                {% for child in children %}
                  <a href="{{ child.link }}" class="block rounded-lg px-4 py-2.5 text-sm text-slate-600 transition hover:bg-slate-50 hover:text-slate-950">{{ child.title }}</a>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    {# Desktop CTA #}
    <div class="hidden items-center gap-3 lg:flex">
      <a href="{{ header_cta_href }}" class="rspku-button rspku-button-primary rspku-button-sm gap-2">
        {{ icon('clipboard-list', { class: 'h-4 w-4' }) }}
        <span>{{ rspku.header_cta_text|default('Daftar Online') }}</span>
      </a>
    </div>

    {# Mobile Hamburger Button #}
    <button type="button" class="grid h-11 w-11 place-items-center rounded-lg border border-slate-200 bg-white text-slate-700 lg:hidden" @click="toggle" :aria-expanded="open.toString()" aria-label="Buka menu navigasi">
      <svg x-show="!open" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg x-cloak x-show="open" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  {# Mobile Menu #}
  <div class="border-t border-slate-100 bg-white lg:hidden" x-cloak x-show="open" x-transition.opacity>
    <nav class="rspku-container space-y-1 py-4" aria-label="Menu mobile">
      {% for item in primary_items %}
        {% set title_lower = item.title|lower %}
        {% set children = item.children is defined and item.children ? item.children : (
          title_lower == 'layanan' ? layanan_children :
          (title_lower == 'fasilitas' ? fasilitas_children :
          (title_lower starts with 'pusat informasi' ? info_children : []))
        ) %}
        {% set has_children = children is not empty %}
        <div>
          <div class="flex items-center justify-between">
            <a href="{{ item.link }}" class="flex-1 rounded-lg px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50" @click="close">{{ item.title }}</a>
            {% if has_children %}
              <button type="button" class="grid h-10 w-10 place-items-center rounded-lg text-slate-400 transition hover:bg-slate-50 hover:text-slate-700" @click="togglePanel('mobile-{{ loop.index }}')">
                <svg class="h-4 w-4 transition" :class="isPanel('mobile-{{ loop.index }}') ? 'rotate-180' : ''" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
            {% endif %}
          </div>
          {% if has_children %}
            <div class="ml-4 space-y-0.5 border-l-2 border-slate-100 pl-4" x-cloak x-show="isPanel('mobile-{{ loop.index }}')" x-transition>
              {% for child in children %}
                <a href="{{ child.link }}" class="block rounded-lg px-3 py-2 text-sm text-slate-600 transition hover:bg-slate-50 hover:text-slate-950" @click="close">{{ child.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
      <div class="border-t border-slate-100 pt-3">
        <a href="{{ header_cta_href }}" class="rspku-button rspku-button-primary w-full" @click="close">
          {{ icon('clipboard-list', { class: 'h-5 w-5' }) }}
          <span>{{ rspku.header_cta_text|default('Daftar Online') }}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1" class="focus:outline-none">
  {% block content %}{% endblock %}
</main>

<footer class="mt-16 border-t border-slate-200 bg-slate-50/50">
  {# Main Footer #}
  <div class="rspku-container py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      {# Brand Column #}
      <div class="space-y-5">
        <a href="{{ site.url }}" class="inline-flex items-center gap-3">
          {% if site_logo.url %}
            <img src="{{ site_logo.url }}" alt="{{ site_logo.alt|default(site.name) }}" class="h-12 w-auto object-contain">
          {% else %}
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-hospital-700 text-lg font-black text-white">PKU</span>
          {% endif %}
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-slate-600">{{ rspku.footer_tagline|default('Mendampingi kesehatan Anda dan keluarga dengan pelayanan profesional yang berlandaskan nilai Islami.') }}</p>

        {# Call Center Contact - Prominent #}
        <a href="tel:{{ rspku.phone_igd_link }}" class="inline-flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 transition hover:bg-red-100">
          <div class="grid h-10 w-10 place-items-center rounded-lg bg-red-600 text-white">
            {{ icon('phone', { class: 'h-5 w-5' }) }}
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-red-700">Call Center 1</p>
            <p class="text-sm font-bold text-slate-950">{{ rspku.phone_igd }}</p>
          </div>
        </a>

        {# Social Media - Compact (dynamic from settings) #}
        <div class="flex items-center gap-2">
          <span class="text-xs font-medium text-slate-500">Ikuti kami:</span>
          {% if rspku.social_instagram %}
            <a href="{{ rspku.social_instagram }}" target="_blank" rel="noopener" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 text-slate-400 transition hover:border-hospital-200 hover:text-hospital-700" aria-label="Instagram">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1"/>
              </svg>
            </a>
          {% endif %}
          {% if rspku.social_youtube %}
            <a href="{{ rspku.social_youtube }}" target="_blank" rel="noopener" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 text-slate-400 transition hover:border-hospital-200 hover:text-hospital-700" aria-label="YouTube">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
          {% if rspku.social_facebook %}
            <a href="{{ rspku.social_facebook }}" target="_blank" rel="noopener" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 text-slate-400 transition hover:border-hospital-200 hover:text-hospital-700" aria-label="Facebook">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          {% if rspku.social_linkedin %}
            <a href="{{ rspku.social_linkedin }}" target="_blank" rel="noopener" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 text-slate-400 transition hover:border-hospital-200 hover:text-hospital-700" aria-label="LinkedIn">
              {{ icon('linkedin', { class: 'h-4 w-4' }) }}
            </a>
          {% endif %}
        </div>
      </div>

      {# Layanan Column — from settings or hardcoded fallback #}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900">Layanan</h3>
        <ul class="mt-5 space-y-3 text-sm text-slate-600">
          {% if rspku.footer_quick_links is defined and rspku.footer_quick_links is not empty %}
            {% for link in rspku.footer_quick_links %}
              <li><a href="{{ link.url starts with 'http' ? link.url : site.url ~ link.url }}" class="transition hover:text-hospital-700">{{ link.label }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ site.url }}/dokter/" class="transition hover:text-hospital-700">Cari Dokter</a></li>
            <li><a href="{{ site.url }}/jadwal-dokter/" class="transition hover:text-hospital-700">Jadwal Dokter</a></li>
            <li><a href="{{ site.url }}/poliklinik/" class="transition hover:text-hospital-700">Poliklinik</a></li>
            <li><a href="{{ site.url }}/layanan/" class="transition hover:text-hospital-700">Layanan Medis</a></li>
            <li><a href="{{ site.url }}/fasilitas-rawat-inap/" class="transition hover:text-hospital-700">Rawat Inap</a></li>
          {% endif %}
        </ul>
      </div>

      {# Informasi Column #}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900">Informasi</h3>
        <ul class="mt-5 space-y-3 text-sm text-slate-600">
          <li><a href="{{ site.url }}/sejarah-kami/" class="transition hover:text-hospital-700">Tentang Kami</a></li>
          <li><a href="{{ site.url }}/manajemen-rs/" class="transition hover:text-hospital-700">Manajemen RS</a></li>
          <li><a href="{{ site.url }}/berita-artikel/" class="transition hover:text-hospital-700">Berita & Artikel</a></li>
          <li><a href="{{ site.url }}/e-jurnal/" class="transition hover:text-hospital-700">E-Jurnal</a></li>
          <li><a href="{{ site.url }}/karir/" class="transition hover:text-hospital-700">E-Career</a></li>
        </ul>
      </div>

      {# Kontak Column #}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-900">Kontak</h3>
        <ul class="mt-5 space-y-4 text-sm text-slate-600">
          <li class="flex items-start gap-3">
            {{ icon('map-pin', { class: 'h-4 w-4 shrink-0 text-hospital-600 mt-0.5' }) }}
            <div>
              <p class="font-medium text-slate-700">Alamat</p>
              <p class="mt-0.5 leading-relaxed">{{ rspku.address_street }}, {{ rspku.address_district }}, {{ rspku.address_city }}, {{ rspku.address_province }}</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            {{ icon('phone', { class: 'h-4 w-4 shrink-0 text-hospital-600 mt-0.5' }) }}
            <div>
              <p class="font-medium text-slate-700">Pusat Panggilan</p>
              <a href="tel:{{ rspku.phone_igd_link }}" class="mt-0.5 block leading-relaxed hover:text-hospital-700">Call Center 1: {{ rspku.phone_igd }}</a>
              <a href="tel:{{ rspku.phone_main_link }}" class="mt-0.5 block leading-relaxed hover:text-hospital-700">Call Center 2: {{ rspku.phone_main }}</a>
              <a href="tel:{{ rspku.whatsapp_link }}" class="mt-0.5 block leading-relaxed hover:text-hospital-700">Call Center 3: {{ rspku.whatsapp }}</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            {{ icon('mail', { class: 'h-4 w-4 shrink-0 text-hospital-600 mt-0.5' }) }}
            <div>
              <p class="font-medium text-slate-700">Email</p>
              <a href="mailto:{{ rspku.email }}" class="mt-0.5 block leading-relaxed hover:text-hospital-700">{{ rspku.email }}</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            {{ icon('clock', { class: 'h-4 w-4 shrink-0 text-hospital-600 mt-0.5' }) }}
            <div>
              <p class="font-medium text-slate-700">Jam Operasional</p>
              <p class="mt-0.5 leading-relaxed">IGD buka 24 jam<br>Poliklinik: 07.00 - 20.00 WIB</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  {# Bottom Bar #}
  <div class="border-t border-slate-200 bg-white">
    <div class="rspku-container py-5">
